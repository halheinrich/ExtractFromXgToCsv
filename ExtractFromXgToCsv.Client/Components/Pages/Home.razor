@using BgDataTypes_Lib
@using XgFilter_Lib.Filtering
@using XgFilter_Razor
@using ExtractFromXgToCsv.Client.Services
@using ExtractFromXgToCsv.Client.Shared
@using Microsoft.Extensions.Logging
@page "/"
@rendermode @(new InteractiveWebAssemblyRenderMode(prerender: false))
@implements IDisposable
@inject HttpClient Http
@inject FilterSetup FilterSetup
@inject BrowserStorageCondition StorageCondition
@inject SettingsStorage Settings
@inject LocalJobsClient Jobs
@inject LocalJobTiming Timing
@inject ILogger<Home> Logger

<PageTitle>ExtractFromXgToCsv</PageTitle>

<h1>Extract XG Decisions to CSV</h1>

@* A condition notice, dismissible per occurrence (SPEC-notices.md §1, §2).
   The occurrence is the app's, not this page's: the browser refused a storage
   call this visit, whoever made it — this page's settings, either mode
   panel's, or the filter surface's own. Its owner is the app-scoped
   BrowserStorageCondition, which holds the occurrence and the dismissal both;
   this page keeps neither bit, so a remount over a dismissed notice says
   nothing again, and a refusal made while this page was absent is shown on
   return.

   Refusals arrive from calls this page never awaits — a panel's restore after
   this page has rendered, a filter commit answered after a navigation — so
   this block is carried by the condition's notification (see OnInitialized),
   not by the render that follows this page's own gestures.

   Dismissing it hides nothing the screen needs: every control below shows
   the value it holds, restored or not, which is what makes it a condition and
   not a gate reason. The wording claims only what is true when reads succeed
   and writes are refused (Hal's ruling, halheinrich/backgammon#374). *@
@if (StorageCondition.HasOccurred)
{
    <Notice id="storageUnavailableNotice" style="max-width:800px"
            Kind="NoticeKind.Warning" Announcement="NoticeAnnouncement.Assertive"
            Dismissible="true"
            @bind-Dismissed:get="StorageCondition.IsNoticeDismissed"
            @bind-Dismissed:set="_ => StorageCondition.DismissNotice()">
        This page had trouble using your browser's storage. You can keep using it, but some settings may not be restored or saved.
    </Notice>
}

<div class="mb-3" style="max-width:800px">
    <label class="form-label d-block">Output format</label>
    <div class="form-check form-check-inline">
        <input class="form-check-input" type="radio" name="outputFormat" id="fmtCsv"
               checked="@(_outputFormat == OutputFormat.Csv)"
               @onchange="@(() => SetOutputFormat(OutputFormat.Csv))" />
        <label class="form-check-label" for="fmtCsv">CSV</label>
    </div>
    <div class="form-check form-check-inline">
        <input class="form-check-input" type="radio" name="outputFormat" id="fmtDiagram"
               checked="@(_outputFormat == OutputFormat.DiagramJson)"
               @onchange="@(() => SetOutputFormat(OutputFormat.DiagramJson))" />
        <label class="form-check-label" for="fmtDiagram">Diagram JSON</label>
    </div>
    <div class="form-check form-check-inline">
        <input class="form-check-input" type="radio" name="outputFormat" id="fmtPptx"
               checked="@(_outputFormat == OutputFormat.Pptx)"
               disabled="@(_appMode != "Local")"
               @onchange="@(() => SetOutputFormat(OutputFormat.Pptx))" />
        <label class="form-check-label" for="fmtPptx">
            PPTX
            @if (_appMode != "Local")
            {
                <small class="text-muted ms-1">(Local mode only)</small>
            }
        </label>
    </div>
    <div class="form-check form-check-inline">
        <input class="form-check-input" type="radio" name="outputFormat" id="fmtPdf"
               checked="@(_outputFormat == OutputFormat.Pdf)"
               disabled="@(_appMode != "Local")"
               @onchange="@(() => SetOutputFormat(OutputFormat.Pdf))" />
        <label class="form-check-label" for="fmtPdf">
            PDF
            @if (_appMode != "Local")
            {
                <small class="text-muted ms-1">(Local mode only)</small>
            }
        </label>
    </div>
    <div class="form-check form-check-inline">
        <input class="form-check-input" type="radio" name="outputFormat" id="fmtXgp"
               checked="@(_outputFormat == OutputFormat.Xgp)"
               @onchange="@(() => SetOutputFormat(OutputFormat.Xgp))" />
        <label class="form-check-label" for="fmtXgp">XGP positions</label>
    </div>
</div>

@if (_outputFormat == OutputFormat.Xgp)
{
    @* The saved numbering record cannot be read (SPEC-notices.md §7.5): it
       may hold exports this browser has not accounted for, so it is never
       read as nothing outstanding. A gate reason — XGP export is blocked, in
       either mode, until the user resolves it — so not dismissible (§4), and
       assertive. It suggests no number. Its action is the user's deliberate
       resolution, which replaces the document with a fresh record and nothing
       more: the page then reconciles before XGP is admitted. *@
    @if (_numbering.IsUnreadable)
    {
        <Notice class="unreadable-numbering-notice mb-3" style="max-width:800px"
                Kind="NoticeKind.Warning" Announcement="NoticeAnnouncement.Assertive">
            <div>
                This browser's saved XGP numbering couldn't be read: it may be damaged, or saved by
                a newer version of this app. It may record exports that haven't been accounted for,
                so XGP export waits until you decide. Continuing replaces it with a fresh record;
                check the output folder and set the numbering yourself.
            </div>
            <button class="btn btn-sm btn-outline-dark mt-2" @onclick="ResolveUnreadableAsync">
                Replace it and continue
            </button>
        </Notice>
    }
    @* A Local XGP export lost with an earlier server instance
       (SPEC-notices.md §7.5): nothing still holds its accounting, and its
       files may be on disk. A gate reason — XGP export is blocked until the
       user resolves it — so not dismissible (§4), and assertive. It names the
       export from what the record captured, shows this browser's last number
       as information only, and carries the user's deliberate resolution as
       its action. No number is inferred from file names. *@
    @foreach (var lost in _reconciler.LostJobs)
    {
        <Notice class="lost-export-notice mb-3" style="max-width:800px"
                Kind="NoticeKind.Warning" Announcement="NoticeAnnouncement.Assertive">
            <div>
                An earlier XGP export didn't report back before the server stopped: pattern
                <code>@lost.Options.NamePattern</code>, numbered from @lost.Options.StartNumber,
                into <code>@lost.Folder</code>. It may have written files there; existing
                files are never overwritten.
            </div>
            <div class="small mt-1">
                For information: @LastCountedLine
            </div>
            <button class="btn btn-sm btn-outline-dark mt-2" @onclick="() => ResolveLostAsync(lost.JobId)">
                I've checked — continue
            </button>
        </Notice>
    }
    <div class="mb-3 border rounded p-3" style="max-width:800px" id="xgpOptions">
        <label class="form-label d-block fw-bold">XGP export options</label>
        <div class="row g-3">
            @* The pattern column grows to take whatever the fixed-width
               columns leave, so the pattern — the field users actually type
               prose-length templates into — gets the widest share of the row. *@
            <div class="col" style="min-width:220px">
                <label class="form-label" for="xgpPattern">Name pattern</label>
                <input class="form-control" id="xgpPattern"
                       value="@_xgpPattern" @oninput="OnXgpPatternChanged" />
            </div>
            <div class="col-auto">
                <label class="form-label" for="xgpInsertToken">Insert token</label>
                <select class="form-select" id="xgpInsertToken" style="max-width:200px"
                        value="@_xgpTokenSelection" @onchange="OnXgpInsertTokenAsync">
                    <option value="" disabled>Insert token…</option>
                    @foreach (var token in XgpNameTokens.All)
                    {
                        <option value="@token.Name">{@token.Name} — @token.Description</option>
                    }
                </select>
            </div>
            <div class="col-auto">
                <label class="form-label" for="xgpNextNumber">Next number</label>
                <input class="form-control" id="xgpNextNumber" type="number" min="1"
                       style="max-width:90px"
                       value="@_xgpNextNumber" @oninput="OnXgpNextNumberChanged" />
            </div>
            <div class="col-auto">
                <label class="form-label" for="xgpSuffixLength">Number length</label>
                <input class="form-control" id="xgpSuffixLength" type="number" min="1" max="9"
                       style="max-width:90px"
                       value="@_xgpSuffixLength" @oninput="OnXgpSuffixLengthChanged" />
            </div>
        </div>
        <div class="form-check mt-3">
            <input class="form-check-input" type="checkbox" id="xgpAnonymize"
                   checked="@_xgpAnonymize" @onchange="OnXgpAnonymizeChanged" />
            <label class="form-check-label" for="xgpAnonymize">
                Anonymize player names
                <small class="text-muted ms-1">
                    (rewrites every exported position's names to “On-roll” / “Opponent”)
                </small>
            </label>
        </div>
        @if (_xgpOptions.TryValidate(out var xgpError))
        {
            // Throwaway allocator over a synthetic sample decision, rendered
            // twice: shows the {n} advance for counter patterns and the
            // " (2)" uniquifier for patterns without {n}.
            var preview = XgpNameAllocator.Create(_xgpOptions, FilterInEffect ?? new FilterConfig());
            <small class="text-muted" id="xgpPreview">
                Files are named @preview.Next(XgpNamePreview.SampleRow), @preview.Next(XgpNamePreview.SampleRow), …
                one per exported decision (preview values come from a sample decision).
            </small>
        }
        else
        {
            <div class="text-danger small mt-1">@xgpError</div>
        }
    </div>
}

@* The whole filter surface — the filter panel, and in Local mode the
   saved-filters section with its degrade notices — is one producer composite
   over the app-scoped FilterSetup. This host binds only what is its own to
   say here: the saved-filters storage seam (per mode — see Storage). The
   source is reported to the owner, not bound (see ReportSource), and the
   filter in effect is read from it (see FilterInEffect); storage refusals
   reach BrowserStorageCondition, this app's registered sink.

   Mounted from the first render. The owner outlives this page, so a remount
   shows the existing setup as it stands; nothing here waits on this page's
   restore, because nothing is told a source until this page knows it. *@
<FilterSurface Storage="Storage" />

@* No mode panel until the restore has resolved the mode: the panels are where
   a source is latched (a folder committed, files picked), and the mode decides
   which source there is. Rendering Web's panel while the answer is not yet in
   would let a pick land in a Local app, and would read and write the Web
   panel's settings on every Local visit. *@
@if (_sourceResolved)
{
    if (_appMode == "Local")
    {
        <LocalModePanel OutputFormat="_outputFormat"
                        Source="Source"
                        FilterInEffect="FilterInEffect"
                        FolderPath="@_folderPathText"
                        FolderPathChanged="OnFolderPathEdited"
                        OnFolderPathCommitted="OnFolderPathCommitted"
                        XgpOptions="_xgpOptions"
                        XgpAnonymize="_xgpAnonymize"
                        StartState="_reconciler.State"
                        OnXgpJobStarting="OnXgpJobStartingAsync"
                        OnXgpJobEnded="_reconciler.ApplyEndedAsync"
                        OnXgpJobNeverStarted="_reconciler.ResolveNeverStartedAsync"
                        OnReconcileNeeded="_reconciler.ReconcileAsync" />
    }
    else
    {
        <WebModePanel OutputFormat="_outputFormat"
                      FilterInEffect="FilterInEffect"
                      OnSelectionChanged="OnWebSelectionChanged"
                      XgpOptions="_xgpOptions"
                      XgpAnonymize="_xgpAnonymize"
                      XgpNumberingUnreadable="_numbering.IsUnreadable"
                      OnXgpExportStarting="OnXgpExportStarting"
                      OnXgpExported="OnXgpExported" />
    }
}

@code {
    private string _appMode = "Web";
    private OutputFormat _outputFormat = OutputFormat.Csv;

    // ── Source identity ─────────────────────────────────────────────────────
    //
    // The facts the source is minted from arrive asynchronously: the folder
    // path from storage, and the mode from /api/appmode, both in the
    // first-render restore below. Until both have arrived this page's answer
    // to "what is the current source?" is not "none" — it is "not yet known".
    // FilterSetup.ReportSource(null) is a real answer and ends an existing
    // setup, so the source is reported only once it is known: _sourceResolved
    // is false until the restore has resolved the mode and the folder, and
    // ReportSource does nothing before then. No mode panel renders before then
    // either, so no gesture can latch a source the page cannot yet place. A
    // return to this page over an unchanged folder therefore reports the same
    // token once, which ends nothing — the setup, its baseline and its
    // generation stand.
    private bool _sourceResolved;

    // Local mode's source is the input folder path. Two fields on purpose:
    // _folderPathText follows every keystroke (LocalModePanel is a controlled
    // input; persistence stays per-keystroke), while _localSourcePath moves
    // only at the @onchange boundary — the source must never change per
    // keystroke.
    private string _folderPathText = string.Empty;
    private string? _localSourcePath;

    // Web mode's source is the file selection, whose bytes and rows belong to
    // WebModePanel; the panel mints the selection's token and hands it here
    // (OnWebSelectionChanged). Null while nothing is selected.
    private FilterSourceToken? _webSelection;

    // The saved-filters storage seam, created once over a delegate reading the
    // latched folder: FilterSurface rebuilds its store when the bound Storage
    // *reference* changes, so the live-folder fact must ride the delegate, not
    // a fresh instance. Page-lifetime is exactly enough — the composite dies
    // with this page.
    private HttpDocumentStorage? _documentStorage;

    private IDisposable? _filterSetupAttachment;
    private IDisposable? _storageConditionAttachment;

    // ── This page's lifetime ────────────────────────────────────────────────
    //
    // The one fact of whether this page is still the page: cancelled in
    // Dispose. The owners it reports to outlive it, and its restore is async —
    // a navigation can dispose this page while it waits on storage or on
    // /api/appmode, and a newer page can establish another source meanwhile.
    // Work this page no longer owns is cancelled (the app-mode request is
    // handed the token; each restore step stops on it), and nothing is
    // published once it is cancelled (ReportSource). A storage call already
    // in flight is not abandoned: it completes, and a refusal still reaches
    // the app-scoped condition — only this page's use of the answer stops.
    private readonly CancellationTokenSource _lifetime = new();

    /// <summary>
    /// The current source's token — the one property both the reports and the
    /// reads use. Local = the latched folder path; Web = the token of the
    /// selection WebModePanel holds. Null while no source exists (blank path,
    /// nothing selected). The output path is not a source and never appears
    /// here.
    ///
    /// <para>
    /// The path goes to <see cref="FilterSourceToken.FromPath"/> in the
    /// spelling this page holds: what counts as the same folder is a property
    /// of paths, so the factory owns it (halheinrich/backgammon#94). The
    /// latched path itself keeps the user's spelling, for IO and display.
    /// </para>
    /// </summary>
    private FilterSourceToken? Source => _appMode == "Local"
        ? _localSourcePath is { } path
            ? FilterSourceToken.FromPath(path)
            : null
        : _webSelection;

    /// <summary>
    /// The filter in effect for the source on screen right now, or
    /// <see langword="null"/> when none is — the one filter fact this page
    /// hands the mode panels, read from the owner on each ask
    /// (<see cref="FilterSetupSnapshot.ConfigInEffectFor"/>, a new instance
    /// each call). Source-relative by construction: a setup whose source is not
    /// this page's current one reads as nothing in effect. The ready empty
    /// selection is in effect without Apply (halheinrich/backgammon#266); this
    /// page adds no exception of its own.
    /// </summary>
    private FilterConfig? FilterInEffect =>
        Source is { } source ? FilterSetup.Current.ConfigInEffectFor(source) : null;

    /// <summary>
    /// The composite's storage seam: the HTTP adapter while Local mode has a
    /// latched folder to address, null otherwise — a blank path must render no
    /// saved-filters section, never a load failure. Web mode is always null
    /// (ruled: no second store; localStorage fallback is forbidden drift).
    /// </summary>
    private IDocumentStorage? Storage =>
        _appMode == "Local" && _localSourcePath is not null ? _documentStorage : null;

    protected override void OnInitialized()
    {
        _documentStorage = new HttpDocumentStorage(Http, () => _localSourcePath);
        _numbering = new XgpNumberingKeeper(new XgpNumberingStore(Settings));
        _reconciler = new LocalReconciler(Jobs, _numbering, Timing, FollowRecordAfterPassAsync, Logger, _lifetime.Token);
        _reconciler.Changed += () => _ = InvokeAsync(StateHasChanged);

        // Both owners outlive this page and change while no gesture of this
        // page is running — a commit on the filter surface, a refusal from a
        // panel's restore or from the surface's own storage — so this page
        // re-renders off their notifications. It keeps no copy of either
        // owner's state — it reads both at render — so a remount shows what
        // happened while it was absent, a refusal included, with no further
        // failure.
        _filterSetupAttachment = FilterSetup.Attach(_ => StateHasChanged());
        _storageConditionAttachment = StorageCondition.Attach(StateHasChanged);
    }

    public void Dispose()
    {
        _lifetime.Cancel();
        _lifetime.Dispose();
        _filterSetupAttachment?.Dispose();
        _storageConditionAttachment?.Dispose();
    }

    // XGP export options. Home owns the option state (and its persistence);
    // the panels receive an immutable XgpExportOptions snapshot and report
    // back through OnXgpExported so the counter can advance.
    private string _xgpPattern = XgpExportOptions.DefaultNamePattern;
    private string _xgpTokenSelection = string.Empty;
    private int _xgpNextNumber = 1;
    private int _xgpSuffixLength = 3;
    private bool _xgpAnonymize = false;
    private XgpExportOptions _xgpOptions = new();

    // The numbering record (SPEC-notices.md §7.5): one storage document, of
    // which this page is the one owner — the panels never write it. Its
    // numbering is what "next number" continues while the pattern matches it.
    private XgpNumberingKeeper _numbering = default!;

    // Local mode's reconciliation with the server (§7.5): the instance every
    // start names, the XGP ledger's entries applied, the owed jobs followed or
    // settled, and what a start may do now. It keeps the record through
    // _numbering, and lives as long as this page.
    private LocalReconciler _reconciler = default!;

    // The last number this browser counted, for the lost-export notice: as
    // information only, never a number the export resumes from.
    private string LastCountedLine => _numbering.Record.Numbering is { } numbering
        ? $"this browser last counted number {numbering.LastNumber}, under the pattern {numbering.Pattern}."
        : "this browser has counted no XGP numbers yet.";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        // Read once, while this page is certainly live: the source is
        // disposed with the page, and the token outlives it.
        var lifetime = _lifetime.Token;
        try
        {
            await RestoreAsync(lifetime);
        }
        catch (OperationCanceledException) when (lifetime.IsCancellationRequested)
        {
            // Disposed mid-restore: nothing read here is this page's to use,
            // and nothing is reported.
        }
    }

    private async Task RestoreAsync(CancellationToken lifetime)
    {
        // Every read below answers the stored value, or null for "nothing
        // stored" and for a refusal alike — SettingsStorage has reported a
        // refusal to the condition before it returns — so each key lands on
        // its stored value or its own documented default, and the restore
        // runs to the end while this page lives. Each read completes whatever
        // happens to the page (a refusal still reaches the condition); the
        // restore stops after it if the page has gone.
        async Task<string?> ReadSettingAsync(string key)
        {
            var value = await Settings.ReadAsync(key);
            lifetime.ThrowIfCancellationRequested();
            return value;
        }

        // The inverse of what persists it below (fmt.ToString()): resolve the
        // stored token by searching the declared formats, never by parsing.
        // Enum.TryParse would also accept a numeric ordinal, tying a durable
        // localStorage entry to member numbering (halheinrich/backgammon#164);
        // an unrecognized token leaves the default standing, as before.
        var savedFormat = await ReadSettingAsync("xg_outputFormat");
        foreach (var candidate in Enum.GetValues<OutputFormat>())
        {
            if (string.Equals(savedFormat, candidate.ToString(), StringComparison.Ordinal))
            {
                _outputFormat = candidate;
                break;
            }
        }

        // Restore the Local-mode folder path and latch it: a restored path is
        // a committed value — the saved-filters context loads for it, and the
        // source is minted from it — not a keystroke in flight.
        _folderPathText = await ReadSettingAsync("xg_folderPath") ?? string.Empty;
        LatchSourceFolder(_folderPathText);

        // The numbering record — the one document, or, the first time, what
        // the keys it replaced held (XgpNumberingStore migrates them once,
        // the legacy prefix included). The controls start from its numbering;
        // when what is stored cannot be read, they keep their defaults, no
        // number is suggested, and XGP waits on the gate above.
        await _numbering.RestoreAsync();
        lifetime.ThrowIfCancellationRequested();
        if (_numbering.Record.Numbering is { } numbering)
        {
            _xgpPattern = numbering.Pattern;
            _xgpNextNumber = numbering.LastNumber + 1;
            _xgpSuffixLength = numbering.SuffixLength;
        }
        var savedAnonymize = await ReadSettingAsync("xg_xgpAnonymize");
        _xgpAnonymize = bool.TryParse(savedAnonymize, out var anon) && anon;
        RebuildXgpOptions();

        try
        {
            var response = await Http.GetFromJsonAsync<AppModeResponse>("/api/appmode", lifetime);
            _appMode = response?.Mode ?? "Web";
        }
        catch (Exception) when (!lifetime.IsCancellationRequested)
        {
            _appMode = "Web";
        }
        lifetime.ThrowIfCancellationRequested();

        if ((_outputFormat == OutputFormat.Pptx || _outputFormat == OutputFormat.Pdf)
            && _appMode != "Local")
            _outputFormat = OutputFormat.Csv;

        // Last, after every fact Source is minted from: the source is known
        // now, so report it. An unchanged source — a return over the same
        // folder — ends nothing; a different one, or none, ends the setup.
        _sourceResolved = true;
        ReportSource();

        StateHasChanged();

        // Local mode reconciles with the server as the page loads
        // (SPEC-notices.md §7.5) — after the first render, so the panel is
        // on screen saying it is checking while the answer comes in.
        if (_appMode == "Local")
            await _reconciler.StartAsync();
    }

    // ── Source reporting ────────────────────────────────────────────────────

    // Tells the owner the current source at each moment this page latches
    // one: the restore resolving the mode and folder, a Local folder commit,
    // a Web selection change. Nothing before the restore has resolved the
    // source (see _sourceResolved) — the markup already renders no panel to
    // latch one before then — and nothing once this page's lifetime has
    // ended: a disposed page's source is not the app's. Both rules are kept
    // here, where the report is made.
    private void ReportSource()
    {
        if (_sourceResolved && !_lifetime.IsCancellationRequested)
            FilterSetup.ReportSource(Source);
    }

    // Per-keystroke half of the Local folder input: follow the text and
    // persist it — never latch, never report. A half-typed path is not a
    // source change.
    private async Task OnFolderPathEdited(string path)
    {
        _folderPathText = path;
        await Settings.WriteAsync("xg_folderPath", path);
    }

    // Change-boundary half: latch the committed path and report it. A blur
    // that commits the same folder reports the same token and ends nothing.
    private void OnFolderPathCommitted(string path)
    {
        LatchSourceFolder(path);
        ReportSource();
    }

    private void LatchSourceFolder(string path)
    {
        var trimmed = path.Trim();
        _localSourcePath = trimmed.Length == 0 ? null : trimmed;
    }

    // A Web-mode selection gesture replaced or cleared the selection: hold its
    // token and report it. A new selection carries a new token, so the setup
    // ends; a cleared one reports no source.
    private void OnWebSelectionChanged(FilterSourceToken? selection)
    {
        _webSelection = selection;
        ReportSource();
    }

    private async Task SetOutputFormat(OutputFormat fmt)
    {
        _outputFormat = fmt;
        await Settings.WriteAsync("xg_outputFormat", fmt.ToString());
        StateHasChanged();
    }

    private void RebuildXgpOptions() =>
        _xgpOptions = new XgpExportOptions
        {
            NamePattern = _xgpPattern,
            StartNumber = _xgpNextNumber,
            SuffixLength = _xgpSuffixLength,
        };

    private void OnXgpPatternChanged(ChangeEventArgs e) =>
        ApplyPatternEdit(e.Value?.ToString() ?? string.Empty);

    private void ApplyPatternEdit(string pattern)
    {
        NoteEdit();
        _xgpPattern = pattern;
        // Continue the recorded numbering only while the pattern matches the
        // one it was recorded under; a different pattern starts a fresh
        // series at 1. The user can still override the number afterwards.
        _xgpNextNumber = _numbering.Record.Numbering is { } numbering && _xgpPattern == numbering.Pattern
            ? numbering.LastNumber + 1
            : 1;
        RebuildXgpOptions();
    }

    private async Task OnXgpInsertTokenAsync(ChangeEventArgs e)
    {
        var name = e.Value?.ToString();
        if (string.IsNullOrEmpty(name)) return;

        // Caret-position insertion is deliberately out of scope — the token
        // is appended to the pattern.
        ApplyPatternEdit(_xgpPattern + "{" + name + "}");

        // Snap the dropdown back to its placeholder in a second render:
        // going straight to "" would diff as no change against the previous
        // render's "" and leave the DOM showing the picked token.
        _xgpTokenSelection = name;
        await Task.Yield();
        _xgpTokenSelection = string.Empty;
    }

    private void OnXgpNextNumberChanged(ChangeEventArgs e)
    {
        NoteEdit();
        if (int.TryParse(e.Value?.ToString(), out var n))
            _xgpNextNumber = n;
        RebuildXgpOptions();
    }

    private void OnXgpSuffixLengthChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var n))
            _xgpSuffixLength = n;
        RebuildXgpOptions();
    }

    // Anonymize is independent of the naming options (XgpExportOptions), so it
    // isn't folded into RebuildXgpOptions — it rides to the panels as its own
    // bool parameter and persists under its own key.
    private async Task OnXgpAnonymizeChanged(ChangeEventArgs e)
    {
        _xgpAnonymize = e.Value is bool b && b;
        await Settings.WriteAsync("xg_xgpAnonymize", _xgpAnonymize.ToString());
    }

    /// <summary>
    /// Web mode's accounting: a download committed
    /// <see cref="XgpExportCommit.Count"/> entries under the options it
    /// captured, at its successful hand-off. Records the numbering those
    /// entries used, so the next export under the same pattern continues where
    /// this one ended. An export that committed nothing advances nothing.
    /// Local mode's accounting reaches the record through the server's XGP
    /// ledger instead (<see cref="LocalReconciler"/>).
    /// </summary>
    /// <remarks>
    /// Everything recorded comes from <paramref name="commit"/>, never from
    /// the controls: the user may have changed the pattern or the numbers while
    /// the export ran, and the files were named by what it captured. It is one
    /// checkpoint of the numbering record — the whole document, from a fresh
    /// read, in one write; a refused write leaves it recorded in this page.
    /// When the record took the download — it committed something — the
    /// controls follow that taking (<see cref="FollowRecord"/>), as of the
    /// moment the download began (<see cref="OnXgpExportStarting"/>): each
    /// download taken is followed, though its numbering may equal the one the
    /// record held.
    /// </remarks>
    private async Task OnXgpExported(XgpExportCommit commit)
    {
        if (await _numbering.RecordExportAsync(commit))
            FollowRecord(_webExportStartedAt);
        StateHasChanged();
    }

    // ── The controls follow the record ──────────────────────────────────────
    //
    // A moment on this page's own clock — a count of its events, never
    // wall-clock time — for every user edit of the next number or the pattern,
    // every export this page starts, and every time the page sets the controls
    // itself. An edit made after an export started is the user's choice, and
    // the controls keep it (SPEC-notices.md §7.5).
    private long _clock;

    // The moment of the user's last edit of the next number or the pattern;
    // zero for none. A value the page restored or set is not an edit, and
    // changing a control away and back is one.
    private long _lastEditAt;

    // The moment the page last set the controls itself — restored them, or
    // followed the record: zero until it follows anything.
    private long _controlsSetAt;

    // The moment each Local XGP job this page started was recorded as owed,
    // by its identity.
    private readonly Dictionary<string, long> _startedAt = new(StringComparer.Ordinal);

    // The moment the Web panel's XGP download in hand began.
    private long _webExportStartedAt;

    private void NoteEdit() => _lastEditAt = ++_clock;

    // A Local XGP job about to start: its moment is noted, and the host
    // records it as owed and answers whether its start may be sent. A job
    // held back is never sent, so its moment orders nothing.
    private async Task<bool> OnXgpJobStartingAsync(OwedXgpJob job)
    {
        _startedAt[job.JobId] = ++_clock;
        if (await _reconciler.RecordOwedAsync(job))
            return true;
        _startedAt.Remove(job.JobId);
        return false;
    }

    // A Web XGP download beginning: its moment is noted.
    private void OnXgpExportStarting() => _webExportStartedAt = ++_clock;

    // The controls' half of a Local reconciliation's taking: they follow the
    // record, as of the start of the export whose numbering it now holds —
    // known when this page started it; otherwise as of the last time the page
    // set the controls, the latest moment this page knows the export can have
    // started by. A taking whose exports committed nothing changes no number.
    private Task FollowRecordAfterPassAsync(LedgerTaking taking)
    {
        if (taking.Export is { } export)
            FollowRecord(_startedAt.TryGetValue(export.JobId, out var startedAt) ? startedAt : _controlsSetAt);
        return Task.CompletedTask;
    }

    /// <summary>
    /// The controls follow the record's taking of an export
    /// (SPEC-notices.md §7.5): the event, not a change in the numbering's
    /// value, which a new export may leave as it was. The next number follows
    /// the record, unless the user has edited the next number or the pattern
    /// since that export started (<paramref name="exportStartedAt"/>), and
    /// while the pattern is the one the numbering continues. Its callers offer
    /// only what the record took, and only once: a replay is no taking, and an
    /// export that committed nothing moved no number, which is the record's
    /// own rule (<see cref="XgpNumberingRecord.WithCommit"/>). The number
    /// length decides nothing here: it says nothing about which number comes
    /// next.
    /// </summary>
    /// <param name="exportStartedAt">The moment the export the record took started, on this page's clock.</param>
    private void FollowRecord(long exportStartedAt)
    {
        var numbering = _numbering.Record.Numbering;
        if (numbering is null || _lastEditAt > exportStartedAt || numbering.Pattern != _xgpPattern)
            return;
        _xgpNextNumber = numbering.LastNumber + 1;
        RebuildXgpOptions();
        _controlsSetAt = ++_clock;
    }

    // The lost-export notice's action: the user's deliberate resolution.
    private Task ResolveLostAsync(string jobId) => _reconciler.ResolveLostAsync(jobId);

    // The unreadable-record notice's action: the user's deliberate
    // resolution. In Local mode the page then reconciles before XGP is
    // admitted; Web mode has nothing to reconcile with.
    private Task ResolveUnreadableAsync() =>
        _appMode == "Local" ? _reconciler.ResolveUnreadableAsync() : _numbering.ResolveUnreadableAsync();
}