@using BgDataTypes_Lib
@using XgFilter_Lib.Filtering
@using ExtractFromXgToCsv.Client.Services
@using ExtractFromXgToCsv.Client.Shared
@inject XgProcessingService Processor
@inject IJSRuntime JS

<section class="mb-4">
    <div style="max-width:800px">
        <label class="form-label">Select .xg / .xgp files</label>
        @if (!string.IsNullOrEmpty(_lastFolderHint))
        {
            <div><small class="text-muted">Last: @_lastFolderHint</small></div>
        }
        @if (_totalSelectedBytes > WebModeLimitBytes)
        {
            <div class="alert alert-warning mt-1 mb-1 py-1">
                Selected files total @(_totalSelectedBytes / 1024 / 1024)MB —
                limit is @(WebModeLimitBytes / 1024 / 1024)MB.
                Please select fewer files.
            </div>
        }
        <InputFile OnChange="HandleFileSelectionAsync" multiple
                   accept=".xg,.xgp" class="form-control mb-3" />
    </div>
</section>

@if (_hasError && !string.IsNullOrEmpty(_statusMessage))
{
    <div class="alert alert-danger mt-2">@_statusMessage</div>
}

@if (_rows.Count > 0)
{
    <div class="mb-4" style="max-width:800px">
        @if (FilterApplied && !FilterDirty)
        {
            @if (_filteredCount == 0)
            {
                // Rows loaded but the applied filter set excluded every one of
                // them. Because an empty (inactive) set passes every row, a zero
                // count here means the filters are genuinely active — so we can
                // say so without re-inspecting FilterConfig. Replaces the bland
                // "0 of N rows match" line that read as a silent success.
                <div class="alert alert-warning zero-match-notice" role="alert">
                    No decisions matched these filters — adjust the filters or
                    select different files.
                </div>
            }
            else
            {
                <div class="mb-2 text-muted">
                    @_filteredCount of @_rows.Count rows match current filters
                </div>
            }
        }
        else
        {
            <div class="mb-2 text-muted">
                @_rows.Count rows loaded — set filters and click Apply Filter
            </div>
        }

        <label class="form-label">Filename</label>
        <input class="form-control mb-3" style="max-width:400px"
               placeholder="decisions.csv"
               value="@_csvFileName"
               @oninput="OnCsvFileNameChanged" />

        <button class="btn btn-primary"
                @onclick="DownloadAsync"
                disabled="@(_busy || !FilterApplied || FilterDirty || _totalSelectedBytes > WebModeLimitBytes || XgpDownloadBlocked)">
            @(_busy ? "Building…" : DownloadButtonLabel)
        </button>
        @if (!FilterApplied || FilterDirty)
        {
            <small class="text-muted ms-2">Apply filters first</small>
        }
        else if (XgpDownloadBlocked)
        {
            <small class="text-muted ms-2">
                @(_filteredRows.Count == 0
                    ? "No decisions match the filters"
                    : "Fix the XGP export options first")
            </small>
        }
    </div>
}

@if (FilterApplied && !FilterDirty && _filteredRows.Count > 0)
{
    <h5>Preview (first @(Math.Min(20, _filteredRows.Count)) of @_filteredRows.Count filtered rows, @_rows.Count total)</h5>
    <div style="overflow-x:auto">
        <table class="table table-sm table-striped table-bordered">
            <thead class="table-dark">
                <tr>
                    <th>Xgid</th>
                    <th>Error</th>
                    <th>MatchScore</th>
                    <th>MatchLength</th>
                    <th>Player</th>
                    <th>SourceFile</th>
                    <th>Game</th>
                    <th>MoveNumber</th>
                    <th>Roll</th>
                    <th>AnalysisDepth</th>
                    <th>Equity</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in _filteredRows.Take(20))
                {
                    <tr>
                        <td><code style="font-size:.75em">@r.Xgid</code></td>
                        <td>@r.Error</td>
                        <td>@r.MatchScore</td>
                        <td>@r.MatchLength</td>
                        <td>@r.Player</td>
                        <td>@r.SourceFile</td>
                        <td>@r.Game</td>
                        <td>@r.MoveNumber</td>
                        <td>@r.Roll</td>
                        <td>@r.AnalysisDepth</td>
                        <td>@r.Equity</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private const long WebModeLimitBytes = 50L * 1024 * 1024;

    [Parameter] public OutputFormat OutputFormat { get; set; }
    [Parameter, EditorRequired] public FilterConfig FilterConfig { get; set; } = default!;
    [Parameter, EditorRequired] public bool FilterApplied { get; set; }
    [Parameter, EditorRequired] public bool FilterDirty { get; set; }
    [Parameter, EditorRequired] public XgpExportOptions XgpOptions { get; set; } = default!;
    [Parameter, EditorRequired] public bool XgpAnonymize { get; set; }
    [Parameter] public EventCallback<int> OnXgpExported { get; set; }

    private string _csvFileName = "decisions.csv";
    private string _lastFolderHint = string.Empty;
    private long _totalSelectedBytes = 0;
    private bool _busy = false;
    private bool _hasError = false;
    private string _statusMessage = string.Empty;
    private List<DecisionRow> _rows = new();
    private List<DecisionRow> _filteredRows = new();
    private List<BgDecisionData> _diagramRows = new();
    private List<BgDecisionData> _filteredDiagramRows = new();
    private int _filteredCount = 0;

    // Raw bytes of each selected file, keyed by bare filename — retained so
    // the .xgp slice export can re-parse its sources at download time. Raw
    // (zlib-compressed) bytes are kept rather than parsed XgFiles: they are
    // smaller and already bounded by WebModeLimitBytes.
    private readonly Dictionary<string, byte[]> _fileBytes = new();

    // Cached materialization of FilterConfig. FilterPanel mints a new
    // FilterConfig instance on every Apply (XgFilter_Razor's RaiseAsync),
    // so reference inequality reliably signals "rebuild." This keeps the
    // Build() call out of the per-row Matches hot path.
    private DecisionFilterSet? _builtSet;
    private FilterConfig? _lastBuiltConfig;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        _csvFileName = await JS.InvokeAsync<string?>("localStorage.getItem", "xg_csvFileName") ?? "decisions.csv";
        _lastFolderHint = await JS.InvokeAsync<string?>("localStorage.getItem", "xg_lastFolderHint") ?? string.Empty;
        StateHasChanged();
    }

    protected override void OnParametersSet()
    {
        // Re-filter when filter config or applied state changes
        if (FilterApplied && !FilterDirty)
        {
            if (!ReferenceEquals(_lastBuiltConfig, FilterConfig))
            {
                _builtSet = FilterConfig.Build();
                _lastBuiltConfig = FilterConfig;
            }

            if (_rows.Count > 0)
            {
                _filteredRows = _rows.Where(r => _builtSet!.Matches(r)).ToList();
                _filteredDiagramRows = _diagramRows.Where(r => _builtSet!.Matches(r)).ToList();
                _filteredCount = _filteredRows.Count;
            }
        }

        // Update filename extension when output format changes
        if (!string.IsNullOrWhiteSpace(_csvFileName))
        {
            var expectedExt = OutputFormat switch
            {
                OutputFormat.DiagramJson => ".json",
                OutputFormat.Xgp         => ".zip",
                _                        => ".csv",
            };
            if (!_csvFileName.EndsWith(expectedExt, StringComparison.OrdinalIgnoreCase))
            {
                _csvFileName = Path.ChangeExtension(_csvFileName, expectedExt);
                _ = JS.InvokeVoidAsync("localStorage.setItem", "xg_csvFileName", _csvFileName);
            }
        }
    }

    private async Task HandleFileSelectionAsync(InputFileChangeEventArgs e)
    {
        _hasError = false; _statusMessage = string.Empty;
        _rows.Clear(); _filteredRows.Clear();
        _diagramRows.Clear(); _filteredDiagramRows.Clear();
        _fileBytes.Clear();
        _filteredCount = 0;

        var files = e.GetMultipleFiles(500).ToList();
        _totalSelectedBytes = files.Sum(f => f.Size);

        if (_totalSelectedBytes > WebModeLimitBytes)
        {
            _hasError = true;
            _statusMessage = $"Selected files total {_totalSelectedBytes / 1024 / 1024}MB — limit is {WebModeLimitBytes / 1024 / 1024}MB. Please select fewer files.";
            return;
        }

        if (files.Count > 0)
        {
            _lastFolderHint = $"{files.Count} file(s) — first: {files[0].Name}";
            await JS.InvokeVoidAsync("localStorage.setItem", "xg_lastFolderHint", _lastFolderHint);
        }

        try
        {
            foreach (var file in files)
            {
                using var ms = new MemoryStream();
                await file.OpenReadStream(maxAllowedSize: 50 * 1024 * 1024).CopyToAsync(ms);
                var bytes = ms.ToArray();
                _fileBytes[file.Name] = bytes;
                _rows.AddRange(Processor.ExtractDecisions(bytes, file.Name));
                _diagramRows.AddRange(Processor.ExtractDiagramRequests(bytes, file.Name));
            }
        }
        catch (Exception ex)
        {
            _hasError = true;
            _statusMessage = $"Error: {ex.Message}";
        }
    }

    private async Task OnCsvFileNameChanged(ChangeEventArgs e)
    {
        _csvFileName = e.Value?.ToString() ?? string.Empty;
        await JS.InvokeVoidAsync("localStorage.setItem", "xg_csvFileName", _csvFileName);
    }

    // Xgp needs matching decisions and valid naming options before the
    // Download button makes sense; the text formats tolerate an empty set
    // (header-only CSV / empty JSON array), so they stay ungated.
    private bool XgpDownloadBlocked =>
        OutputFormat == OutputFormat.Xgp
        && (_filteredRows.Count == 0 || !XgpOptions.TryValidate(out _));

    private string DownloadButtonLabel => OutputFormat switch
    {
        OutputFormat.DiagramJson => "Download JSON",
        OutputFormat.Xgp         => "Download ZIP",
        _                        => "Download CSV",
    };

    private async Task DownloadAsync()
    {
        _busy = true;
        _hasError = false; _statusMessage = string.Empty;
        try
        {
            byte[] bytes;
            string fileName;
            string mimeType;

            if (OutputFormat == OutputFormat.Xgp)
            {
                bytes = Processor.BuildXgpZip(
                    _fileBytes,
                    _filteredRows.Select(r => r.Id).ToList(),
                    XgpOptions,
                    anonymize: XgpAnonymize);
                fileName = string.IsNullOrWhiteSpace(_csvFileName) ? "decisions.zip" : _csvFileName;
                mimeType = "application/zip";
            }
            else if (OutputFormat == OutputFormat.DiagramJson)
            {
                var content = Processor.BuildDiagramJson(_filteredDiagramRows);
                bytes = System.Text.Encoding.UTF8.GetBytes(content);
                fileName = string.IsNullOrWhiteSpace(_csvFileName) ? "decisions.json" : _csvFileName;
                mimeType = "application/json";
            }
            else
            {
                var content = Processor.BuildCsv(_filteredRows);
                bytes = System.Text.Encoding.UTF8.GetBytes(content);
                fileName = string.IsNullOrWhiteSpace(_csvFileName) ? "decisions.csv" : _csvFileName;
                mimeType = "text/csv";
            }

            await JS.InvokeVoidAsync("downloadFile", fileName, mimeType, bytes);

            if (OutputFormat == OutputFormat.Xgp)
                await OnXgpExported.InvokeAsync(_filteredRows.Count);
        }
        catch (Exception ex)
        {
            _hasError = true;
            _statusMessage = $"Error: {ex.Message}";
        }
        finally { _busy = false; }
    }
}