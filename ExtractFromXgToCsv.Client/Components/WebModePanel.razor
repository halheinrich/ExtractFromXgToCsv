@using BgDataTypes_Lib
@using ConvertXgToJson_Lib
@using XgFilter_Lib.Filtering
@using ExtractFromXgToCsv.Client.Services
@using ExtractFromXgToCsv.Client.Shared
@using XgFilter_Razor
@inject XgProcessingService Processor
@inject SettingsStorage Settings
@inject IJSRuntime JS

@* Panel root. It exists to carry the busy marker: everything the user can
   point at while a gesture holds the WASM thread sits inside it, so one class
   here dresses the whole panel with the busy cursor (app.css owns which
   cursor that is). *@
<div class="@BusyCssClass">

    @if (_busy)
    {
        // The panel's one busy surface. Every slow gesture here runs synchronously
        // on the WASM thread, so this is the only thing the user can see while it
        // does — it must be rendered *and* handed a frame to paint in before the
        // work starts (see RunBusyAsync).
        //
        // A live indicator, so not dismissible, and polite (SPEC-notices.md §1).
        // The spinner-and-text row is laid out by an element of this panel's
        // own, inside the notice: the box's children are the component's (its
        // content wrapper, and a close button on a dismissible one), so flex
        // classes on the box would lay out the component's structure rather
        // than this content — and would reach nothing, the wrapper being the
        // box's only child here.
        <Notice class="busy-notice" style="max-width:800px" Kind="NoticeKind.Information"
                Announcement="NoticeAnnouncement.Polite">
            <div class="d-flex align-items-center gap-2">
                <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
                <span>@_busyMessage</span>
            </div>
        </Notice>
    }

    <section class="mb-4">
        <div style="max-width:800px">
            <label class="form-label">Select .xg / .xgp files</label>
            @if (!string.IsNullOrEmpty(_lastFolderHint))
            {
                <div><small class="text-muted">Last: @_lastFolderHint</small></div>
            }
            @if (_totalSelectedBytes > WebModeLimitBytes)
            {
                // A gate reason — why nothing loaded and the run cannot start —
                // so not dismissible (SPEC-notices.md, Fork C), and the one
                // statement of this fact: it is read straight off
                // _totalSelectedBytes, and the run error no longer repeats it
                // (see HandleFileSelectionAsync). Assertive, because it is now
                // the only thing that tells the user the selection they just
                // made was refused — a gesture that failed.
                <Notice class="mt-1 mb-1 py-1" Kind="NoticeKind.Warning"
                        Announcement="NoticeAnnouncement.Assertive">
                    Selected files total @(_totalSelectedBytes / 1024 / 1024)MB —
                    limit is @(WebModeLimitBytes / 1024 / 1024)MB.
                    Please select fewer files.
                </Notice>
            }
            <InputFile OnChange="HandleFileSelectionAsync" multiple
                       accept=".xg,.xgp" class="form-control mb-3" disabled="@_busy" />
        </div>
    </section>

    <section class="mb-4">
        <div style="max-width:800px">
            <label class="form-label">
                Opening book (.ob) <span class="text-muted">— optional</span>
            </label>
            <InputFile OnChange="HandleOpeningBookSelectionAsync"
                       accept=".ob" class="form-control mb-1" disabled="@_busy" />
            <div class="small" id="bookStatus">
                @if (_bookEntryCount is int entries)
                {
                    <span class="text-success">
                        ✓ Book loaded (@entries entries) — book decisions show their enriched depth.
                    </span>
                }
                else if (_bookLoadFailed)
                {
                    <span class="text-danger">
                        ✗ That file isn't a valid opening book — book decisions will show as level Unknown.
                    </span>
                }
                else
                {
                    <span class="text-muted">
                        No book loaded — book decisions will show as level Unknown.
                        Pick XG's OpeningBookV2.ob to enrich them.
                    </span>
                }
            </div>
        </div>
    </section>

    @* The run error — dismissible (SPEC-notices.md, Fork A), and assertive: a
       gesture the user made failed. One occurrence is one failed gesture (a
       file read or a download build), and _runError is non-null exactly while
       one stands, so closing the box ends the occurrence — the field is
       cleared, as the next selection and the next download already clear it —
       and there is no dismissed bit anywhere, here or in the Notice (the
       binding makes it caller-held, so it keeps none). A second failure
       assigns the field again and shows fresh although its text may be
       identical: the text was never the occurrence. No @if around it — one
       fact, read once. *@
    <Notice class="mt-2" Kind="NoticeKind.Error" Announcement="NoticeAnnouncement.Assertive"
            Dismissible="true"
            @bind-Dismissed:get="_runError is null"
            @bind-Dismissed:set="_ => _runError = null">
        @_runError
    </Notice>

    @if (_rowCache.Rows.Count > 0)
    {
        <div class="mb-4" style="max-width:800px">
            @if (FilterInEffect is not null)
            {
                @if (_rowCache.FilteredRows.Count == 0)
                {
                    // Rows loaded but the applied filter set excluded every one of
                    // them. Because an empty (inactive) set passes every row, a zero
                    // count here means the filters are genuinely active — so we can
                    // say so without re-inspecting FilterConfig. Replaces the bland
                    // "0 of N rows match" line that read as a silent success.
                    //
                    // A gate reason — it is the filter's result — so not
                    // dismissible (SPEC-notices.md, Fork C).
                    <Notice class="zero-match-notice" Kind="NoticeKind.Warning"
                            Announcement="NoticeAnnouncement.Assertive">
                        No decisions matched these filters — adjust the filters or
                        select different files.
                    </Notice>
                }
                else
                {
                    <div class="mb-2 text-muted">
                        @_rowCache.FilteredRows.Count of @_rowCache.Rows.Count rows match current filters
                    </div>
                }
            }
            else
            {
                <div class="mb-2 text-muted">
                    @_rowCache.Rows.Count rows loaded — set filters and click Apply Filter
                </div>
            }

            <label class="form-label">Filename</label>
            <input class="form-control mb-3" style="max-width:400px"
                   placeholder="decisions.csv"
                   value="@_csvFileName"
                   @oninput="OnCsvFileNameChanged" />

            <button class="btn btn-primary"
                    @onclick="DownloadAsync"
                    disabled="@(_busy || FilterInEffect is null || _totalSelectedBytes > WebModeLimitBytes || XgpDownloadBlocked)">
                @(_busy ? "Building…" : DownloadButtonLabel)
            </button>
            @if (FilterInEffect is null)
            {
                <small class="text-muted ms-2">Apply filters first</small>
            }
            else if (XgpDownloadBlocked)
            {
                <small class="text-muted ms-2">
                    @(_rowCache.FilteredRows.Count == 0
                        ? "No decisions match the filters"
                        : "Fix the XGP export options first")
                </small>
            }
        </div>
    }

    @if (FilterInEffect is not null && _rowCache.FilteredRows.Count > 0)
    {
        <h5>Preview (first @(Math.Min(20, _rowCache.FilteredRows.Count)) of @_rowCache.FilteredRows.Count filtered rows, @_rowCache.Rows.Count total)</h5>
        <div style="overflow-x:auto">
            <table class="table table-sm table-striped table-bordered">
                <thead class="table-dark">
                    <tr>
                        <th>Xgid</th>
                        <th>Error</th>
                        <th>MatchScore</th>
                        <th>MatchLength</th>
                        <th>Player</th>
                        <th>SourceFile</th>
                        <th>Game</th>
                        <th>MoveNumber</th>
                        <th>Roll</th>
                        <th>AnalysisDepth</th>
                        <th>Equity</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in _rowCache.FilteredRows.Take(20))
                    {
                        <tr>
                            <td><code style="font-size:.75em">@r.Xgid</code></td>
                            <td>@r.Error</td>
                            <td>@r.MatchScore</td>
                            <td>@r.MatchLength</td>
                            <td>@r.Player</td>
                            <td>@r.SourceFile</td>
                            <td>@r.Game</td>
                            <td>@r.MoveNumber</td>
                            <td>@r.Roll</td>
                            <td>@r.AnalysisDepth</td>
                            <td>@r.Equity</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

</div>

@code {
    private const long WebModeLimitBytes = 50L * 1024 * 1024;

    [Parameter] public OutputFormat OutputFormat { get; set; }

    /// <summary>
    /// The filter in effect for this panel's selection, or
    /// <see langword="null"/> when none is — the host's one filter fact
    /// (<c>Home.FilterInEffect</c>). It gates the Download button, the
    /// preview and the match-count line, and is what the rows are filtered
    /// by. The empty selection is in effect without Apply
    /// (halheinrich/backgammon#266).
    /// </summary>
    /// <remarks>
    /// One fact, so one parameter: a config beside a separate "applied" flag
    /// could disagree with it. The host hands a new instance on each render
    /// (the owner's <c>ConfigInEffectFor</c> does), so the row cache compares
    /// it by value.
    /// </remarks>
    [Parameter, EditorRequired] public FilterConfig? FilterInEffect { get; set; }

    [Parameter, EditorRequired] public XgpExportOptions XgpOptions { get; set; } = default!;
    [Parameter, EditorRequired] public bool XgpAnonymize { get; set; }

    /// <summary>
    /// Raised with an XGP download's commit — the entries of the archive
    /// handed to the browser and the options the download captured — once the
    /// hand-off has succeeded: the host owns the numbering those entries used.
    /// EditorRequired: a silently splatted binding here would lose the
    /// accounting.
    /// </summary>
    [Parameter, EditorRequired] public EventCallback<XgpExportCommit> OnXgpExported { get; set; }

    /// <summary>
    /// Raised once per file-selection gesture — every
    /// <see cref="HandleFileSelectionAsync"/> invocation, because every one
    /// replaces (or clears) the retained selection before anything else runs —
    /// with the new selection's token, or <see langword="null"/> when the
    /// gesture left nothing selected (a dismissed picker, a selection over the
    /// size limit). The selection is Web mode's filter <em>source</em>; the
    /// host reports the token to the filter setup, so a new selection ends
    /// the setup exactly as a new Local folder does. EditorRequired: a
    /// silently splatted binding here is a source change nobody hears of.
    /// </summary>
    [Parameter, EditorRequired] public EventCallback<FilterSourceToken?> OnSelectionChanged { get; set; }

    // ── The selection's identity ────────────────────────────────────────────
    //
    // The selection — its bytes (_fileBytes) and rows (_rowCache) — is this
    // panel's, so its token is too: minted when a gesture selects files, held
    // beside them, and gone with them (a clearing gesture, or this panel's
    // disposal, which takes the bytes with it). Two selections never share a
    // token, also across panel instances: the filter setup outlives every
    // page, so a page-lived counter would mint the same token again after a
    // navigation, and a new pick would inherit an old pick's consent. The
    // counter is therefore process-wide — one per loaded app under
    // WebAssembly — and only ever moves forward.
    private static int s_lastSelectionNumber;
    private FilterSourceToken? _selection;

    private static FilterSourceToken MintSelectionToken() =>
        FilterSourceToken.FromGeneration(Interlocked.Increment(ref s_lastSelectionNumber));

    private string _csvFileName = "decisions.csv";
    private string _lastFolderHint = string.Empty;
    private long _totalSelectedBytes = 0;

    // Busy state for every slow gesture on this panel — raised only through
    // RunBusyAsync, which owns the paint discipline that makes it visible.
    private bool _busy = false;
    private string _busyMessage = string.Empty;

    // Busy marker for the panel root. It rides _busy — the state the panel
    // already keeps, unchanged — so every window RunBusyAsync opens gets the
    // cursor, including any gesture routed through the wrapper later. The
    // class carries no cursor of its own; app.css holds the single rule, the
    // same one LocalModePanel's root uses (issue halheinrich/backgammon#77).
    private string? BusyCssClass => _busy ? "is-busy" : null;

    // The failed gesture standing on screen, as its message; null when none
    // is. The run error notice's whole state — presence, text and dismissal
    // are this one field (see the notice's comment in the markup). The
    // selected-size limit is deliberately not written here: it is a standing
    // gate reason with its own owner, _totalSelectedBytes.
    private string? _runError;

    // Live-preview row state — the loaded rows, the materialized filter, and
    // the filtered projections all live in the cache; the panel only decides
    // *when* a filter is in effect (FilterInEffect) and renders from
    // the cache's properties. Exposed internally so wire tests can pin the
    // panel→cache routing without reflection. The cache is the run's, built
    // for the application's one ranking; extraction reads the ranking back
    // from it, so the rows and the records it filters are one ranking's.
    private readonly FilteredRowCache _rowCache = new(AppRanking.Ranking);
    internal FilteredRowCache RowCache => _rowCache;

    // OpeningBookV2.ob is ~13.6 MB; the InputFile stream default cap (500 KB)
    // would reject it, so the book stream is read with this larger ceiling. The
    // book is a separate pick from the .xg files and is not counted against
    // WebModeLimitBytes.
    private const long OpeningBookMaxBytes = 64L * 1024 * 1024;

    // Raw bytes of each selected file, keyed by bare filename — retained so
    // the .xgp slice export can re-parse its sources at download time. Raw
    // (zlib-compressed) bytes are kept rather than parsed XgFiles: they are
    // smaller and already bounded by WebModeLimitBytes.
    private readonly Dictionary<string, byte[]> _fileBytes = new();

    // Optional opening book, loaded client-side from an uploaded .ob file. When
    // present it enriches book-analysed decisions (matching Local mode's
    // server-loaded book); when absent they degrade to level Unknown. A book
    // chosen after the .xg files triggers re-extraction so ordering doesn't
    // matter. _bookEntryCount is the loaded-and-non-null signal (drives the
    // status line); _bookLoadFailed marks a rejected upload.
    private OpeningBook? _openingBook;
    private int? _bookEntryCount;
    private bool _bookLoadFailed;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        _csvFileName = await Settings.ReadAsync("xg_csvFileName") ?? "decisions.csv";
        _lastFolderHint = await Settings.ReadAsync("xg_lastFolderHint") ?? string.Empty;
        StateHasChanged();
    }

    protected override void OnParametersSet()
    {
        // Re-filter by the filter in effect. Whether one is in effect is the
        // panel's one filtering decision; materialization (cached by config
        // value) and projection live in the cache.
        if (FilterInEffect is { } filter)
            _rowCache.Refilter(filter);

        // Update filename extension when output format changes
        if (!string.IsNullOrWhiteSpace(_csvFileName))
        {
            var expectedExt = OutputFormat switch
            {
                OutputFormat.DiagramJson => ".json",
                OutputFormat.Xgp         => ".zip",
                _                        => ".csv",
            };
            if (!_csvFileName.EndsWith(expectedExt, StringComparison.OrdinalIgnoreCase))
            {
                _csvFileName = Path.ChangeExtension(_csvFileName, expectedExt);
                _ = Settings.WriteAsync("xg_csvFileName", _csvFileName);
            }
        }
    }

    private async Task HandleFileSelectionAsync(InputFileChangeEventArgs e)
    {
        _runError = null;
        _rowCache.Clear();
        _fileBytes.Clear();

        var files = e.GetMultipleFiles(500).ToList();
        _totalSelectedBytes = files.Sum(f => f.Size);

        // Over the limit nothing is read, and a dismissed picker selects
        // nothing: either way the gesture leaves no selection. Otherwise the
        // files are the new selection, with a token of its own.
        var selecting = files.Count > 0 && _totalSelectedBytes <= WebModeLimitBytes;
        _selection = selecting ? MintSelectionToken() : null;

        // The old selection is gone as of the clears above, on every path out
        // of this handler, so the source change is announced unconditionally —
        // once, with the outcome's token — before anything is read.
        await OnSelectionChanged.InvokeAsync(_selection);

        // Over the limit: the reason is on screen already, by the picker,
        // rendered from _totalSelectedBytes itself — a gate reason that stands
        // until the selection changes. It used to be written into the run
        // error as well: one fact in two boxes, and the second copy would now
        // be a dismissible statement of a gate reason (SPEC-notices.md §1).
        // One fact, one owner, one box. And for a dismissed picker the clear
        // above is the whole effect: raising busy for it would flash a notice
        // over no work (the wrapper's yield guarantees the flash would paint).
        if (!selecting) return;

        // The hint is a convenience: a refused write is reported to the
        // storage condition and returns, and the upload goes on. At no point
        // may persisting it stand between the user and their files.
        _lastFolderHint = $"{files.Count} file(s) — first: {files[0].Name}";
        await Settings.WriteAsync("xg_lastFolderHint", _lastFolderHint);

        await RunBusyAsync(
            $"Reading {files.Count} file(s) and extracting decisions…",
            async () =>
            {
                try
                {
                    foreach (var file in files)
                    {
                        using var ms = new MemoryStream();
                        await file.OpenReadStream(maxAllowedSize: 50 * 1024 * 1024).CopyToAsync(ms);
                        _fileBytes[file.Name] = ms.ToArray();
                    }
                    ExtractLoadedFiles();
                }
                catch (Exception ex)
                {
                    _runError = $"Error: {ex.Message}";
                }
            });
    }

    private async Task HandleOpeningBookSelectionAsync(InputFileChangeEventArgs e)
    {
        _bookLoadFailed = false;

        // One message has to cover the whole gesture: the load and the
        // re-extract both hold the thread, so there is no frame in between to
        // update it in. Naming the re-extract when there are files to re-read
        // is what keeps the notice from under-promising a multi-second wait.
        var message = _fileBytes.Count > 0
            ? $"Loading opening book and re-reading {_fileBytes.Count} file(s)…"
            : "Loading opening book…";

        await RunBusyAsync(message, async () =>
        {
            try
            {
                using var ms = new MemoryStream();
                await e.File.OpenReadStream(maxAllowedSize: OpeningBookMaxBytes).CopyToAsync(ms);

                if (Processor.TryLoadOpeningBook(ms.ToArray(), out var book))
                {
                    _openingBook = book;
                    _bookEntryCount = book.EntryCount;
                }
                else
                {
                    _openingBook = null;
                    _bookEntryCount = null;
                    _bookLoadFailed = true;
                }
            }
            catch (Exception)
            {
                _openingBook = null;
                _bookEntryCount = null;
                _bookLoadFailed = true;
            }

            // Re-extract already-loaded files so a book chosen after the .xg
            // files still enriches them — and a currently-applied filter view
            // updates.
            if (_fileBytes.Count > 0)
                ExtractLoadedFiles();
        });
    }

    /// <summary>
    /// Runs <paramref name="body"/> with the panel's busy notice showing.
    /// </summary>
    /// <remarks>
    /// The <c>await Task.Yield()</c> is the load-bearing line. WASM runs Blazor
    /// on one thread and <c>StateHasChanged</c> only *queues* a render, so a
    /// busy state raised immediately before synchronous work never reaches the
    /// screen: the flag flips and reverts inside a single task and the
    /// affordance does nothing while looking correct in review. The yield hands
    /// the thread back so the queued render can paint before
    /// <paramref name="body"/> takes it again. Measured on issue halheinrich/backgammon#53 — without
    /// it, the "Building…" label entered the DOM 14 ms *after* a 6.6 s zip
    /// build had already finished.
    /// <para>
    /// Every slow Web-mode gesture goes through here, so the discipline lives in
    /// one place rather than being re-derived per handler. Each body keeps its
    /// own error handling; this wrapper owns only the busy state, and releases
    /// it in a <c>finally</c> so a throwing body can't strand the notice on
    /// screen. The same render that paints the notice puts <c>is-busy</c> on the
    /// panel root, so the busy cursor is on screen before the body takes the
    /// thread — the yield is what buys both.
    /// </para>
    /// </remarks>
    private async Task RunBusyAsync(string message, Func<Task> body)
    {
        _busy = true;
        _busyMessage = message;
        StateHasChanged();
        await Task.Yield();
        try
        {
            await body();
        }
        finally
        {
            _busy = false;
            _busyMessage = string.Empty;
            StateHasChanged();
        }
    }

    /// <summary>
    /// Test seam for the busy contract — the same wrapper every slow gesture
    /// runs through, reachable without a real file pick so the ordering tests
    /// can supply a body that observes when it was called. Sibling of the
    /// <see cref="RowCache"/> seam; not a production entry point.
    /// </summary>
    internal Task RunBusyForTest(string message, Func<Task> body) =>
        RunBusyAsync(message, body);

    // Re-derives every row from the retained file bytes using the current
    // opening book and hands them to the cache, which re-projects them through
    // the filter already in effect — so rows loaded after an Apply are
    // filtered immediately, and enrichment never depends on the order the
    // file and book picks were made in. Called on a fresh file selection and
    // whenever the book changes. Both extractions state the cache's ranking —
    // the run's one ranking — so the rows are built for the ranking the
    // records are filtered under.
    private void ExtractLoadedFiles()
    {
        var ranking = _rowCache.Ranking;
        var rows = new List<DecisionRow>();
        var diagramRows = new List<BgDecisionData>();
        foreach (var (name, bytes) in _fileBytes)
        {
            rows.AddRange(Processor.ExtractDecisions(bytes, name, ranking, _openingBook));
            diagramRows.AddRange(Processor.ExtractDiagramRequests(bytes, name, ranking, _openingBook));
        }
        _rowCache.ReplaceRows(rows, diagramRows);
    }

    private async Task OnCsvFileNameChanged(ChangeEventArgs e)
    {
        _csvFileName = e.Value?.ToString() ?? string.Empty;
        await Settings.WriteAsync("xg_csvFileName", _csvFileName);
    }

    // Xgp needs matching decisions and valid naming options before the
    // Download button makes sense; the text formats tolerate an empty set
    // (header-only CSV / empty JSON array), so they stay ungated.
    private bool XgpDownloadBlocked =>
        OutputFormat == OutputFormat.Xgp
        && (_rowCache.FilteredRows.Count == 0 || !XgpOptions.TryValidate(out _));

    private string DownloadButtonLabel => OutputFormat switch
    {
        OutputFormat.DiagramJson => "Download JSON",
        OutputFormat.Xgp         => "Download ZIP",
        _                        => "Download CSV",
    };

    private string BuildingMessage => OutputFormat switch
    {
        OutputFormat.DiagramJson => "Building JSON…",
        OutputFormat.Xgp         => "Building ZIP…",
        _                        => "Building CSV…",
    };

    // Not format-gated: CSV is the fast one today, but the builders share this
    // one path and the yield costs a single frame, so gating it would buy a
    // special case and nothing else.
    private Task DownloadAsync() => RunBusyAsync(BuildingMessage, DownloadCoreAsync);

    private async Task DownloadCoreAsync()
    {
        // The gate guarantees a filter in effect; a stale click past it has
        // nothing to build.
        if (FilterInEffect is not { } filter) return;

        _runError = null;
        // What the download depends on, captured at its start: a change to
        // the controls while it runs reinterprets nothing.
        var format = OutputFormat;
        var options = XgpOptions;
        var decisions = _rowCache.FilteredRows;
        try
        {
            byte[] bytes;
            string fileName;
            string mimeType;

            if (format == OutputFormat.Xgp)
            {
                bytes = Processor.BuildXgpZip(
                    _fileBytes,
                    decisions,
                    options,
                    filter,
                    anonymize: XgpAnonymize);
                fileName = string.IsNullOrWhiteSpace(_csvFileName) ? "decisions.zip" : _csvFileName;
                mimeType = "application/zip";
            }
            else if (format == OutputFormat.DiagramJson)
            {
                var content = Processor.BuildDiagramJson(_rowCache.FilteredDiagramRows);
                bytes = System.Text.Encoding.UTF8.GetBytes(content);
                fileName = string.IsNullOrWhiteSpace(_csvFileName) ? "decisions.json" : _csvFileName;
                mimeType = "application/json";
            }
            else
            {
                var content = Processor.BuildCsv(_rowCache.FilteredRows);
                bytes = System.Text.Encoding.UTF8.GetBytes(content);
                fileName = string.IsNullOrWhiteSpace(_csvFileName) ? "decisions.csv" : _csvFileName;
                mimeType = "text/csv";
            }

            await JS.InvokeVoidAsync("downloadFile", fileName, mimeType, bytes);

            // The archive holds an entry per decision — any failure fails the
            // whole build — so the hand-off commits them all.
            if (format == OutputFormat.Xgp)
                await OnXgpExported.InvokeAsync(new XgpExportCommit(options, decisions.Count));
        }
        catch (Exception ex)
        {
            _runError = $"Error: {ex.Message}";
        }
    }
}
