@using BgDataTypes_Lib
@using ConvertXgToJson_Lib
@using XgFilter_Lib.Filtering
@using ExtractFromXgToCsv.Client.Services
@using ExtractFromXgToCsv.Client.Shared
@using XgFilter_Razor
@using Microsoft.Extensions.Logging
@implements IDisposable
@inject XgProcessingService Processor
@inject ISourceConverter Converter
@inject SettingsStorage Settings
@inject IJSRuntime JS
@inject ILogger<WebModePanel> Logger

@* Panel root. It exists to carry the busy marker: everything the user can
   point at while a gesture holds the WASM thread sits inside it, so one class
   here dresses the whole panel with the busy cursor (app.css owns which
   cursor that is). *@
<div class="@BusyCssClass">

    @if (IsBusy)
    {
        // The panel's one busy surface. Every slow gesture here runs synchronously
        // on the WASM thread, so this is the only thing the user can see while it
        // does — it must be rendered *and* handed a frame to paint in before the
        // work starts (see RunBusyAsync).
        //
        // A live indicator, so not dismissible, and polite (SPEC-notices.md §1).
        // The spinner-and-text row is laid out by an element of this panel's
        // own, inside the notice: the box's children are the component's (its
        // content wrapper, and a close button on a dismissible one), so flex
        // classes on the box would lay out the component's structure rather
        // than this content — and would reach nothing, the wrapper being the
        // box's only child here.
        <Notice class="busy-notice" style="max-width:800px" Kind="NoticeKind.Information"
                Announcement="NoticeAnnouncement.Polite">
            <div class="d-flex align-items-center gap-2">
                <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
                <span>@_busyMessage</span>
            </div>
        </Notice>
    }

    <section class="mb-4">
        <div style="max-width:800px">
            <label class="form-label">Select .xg / .xgp files</label>
            @if (!string.IsNullOrEmpty(_lastFolderHint))
            {
                <div><small class="text-muted">Last: @_lastFolderHint</small></div>
            }
            @if (_totalSelectedBytes > WebModeLimitBytes)
            {
                // A gate reason — why nothing loaded and the run cannot start —
                // so not dismissible (SPEC-notices.md, Fork C), and the one
                // statement of this fact: it is read straight off
                // _totalSelectedBytes, and the run error no longer repeats it
                // (see HandleFileSelectionAsync). Assertive, because it is now
                // the only thing that tells the user the selection they just
                // made was refused — a gesture that failed.
                <Notice class="mt-1 mb-1 py-1" Kind="NoticeKind.Warning"
                        Announcement="NoticeAnnouncement.Assertive">
                    Selected files total @(_totalSelectedBytes / 1024 / 1024)MB —
                    limit is @(WebModeLimitBytes / 1024 / 1024)MB.
                    Please select fewer files.
                </Notice>
            }
            <InputFile OnChange="HandleFileSelectionAsync" multiple
                       accept=".xg,.xgp" class="form-control mb-3" disabled="@IsBusy" />
        </div>
    </section>

    <section class="mb-4">
        <div style="max-width:800px">
            <label class="form-label">
                Opening book (.ob) <span class="text-muted">— optional</span>
            </label>
            <InputFile OnChange="HandleOpeningBookSelectionAsync"
                       accept=".ob" class="form-control mb-1" disabled="@IsBusy" />
            <div class="small" id="bookStatus">
                @if (_session.Book is { } book)
                {
                    <span class="text-success">
                        ✓ Book loaded (@book.EntryCount entries) — book decisions show their enriched depth.
                    </span>
                }
                else if (_session.BookLoadFailed)
                {
                    <span class="text-danger">
                        ✗ That file isn't a valid opening book — book decisions will show as level Unknown.
                    </span>
                }
                else
                {
                    <span class="text-muted">
                        No book loaded — book decisions will show as level Unknown.
                        Pick XG's OpeningBookV2.ob to enrich them.
                    </span>
                }
            </div>
        </div>
    </section>

    @* "This selection" (SPEC-notices.md §7.3, projection A): what the current
       output loses from this selection — the files that could not be read,
       and the completed conversion skips of the selected output's
       representation. It belongs to the selection, so a pick, a book change, a
       format switch or a conversion completing changes it; refiltering never
       does. Through the one rendering both modes share. *@
    <div style="max-width:800px">
        <SkipListNotice class="mb-3 selection-skips" Record="_session.SelectionSkips(SelectedRepresentation)"
                        Label="This selection" />
    </div>

    @* The run error — dismissible (SPEC-notices.md, Fork A), and assertive: a
       gesture the user made failed. One occurrence is one failed gesture (a
       selection that could not be taken, or a download that could not be
       built or handed over), and _runError is non-null exactly while one
       stands, so closing the box ends the occurrence — the field is cleared,
       as the next selection and the next download already clear it — and
       there is no dismissed bit anywhere, here or in the Notice (the binding
       makes it caller-held, so it keeps none). A second failure assigns the
       field again and shows fresh although its text may be identical: the
       text was never the occurrence. A file that could not be read is not a
       run error: it is the selection's read skip, above. No @if around it —
       one fact, read once. *@
    <Notice class="mt-2" Kind="NoticeKind.Error" Announcement="NoticeAnnouncement.Assertive"
            Dismissible="true"
            @bind-Dismissed:get="_runError is null"
            @bind-Dismissed:set="_ => _runError = null">
        @_runError
    </Notice>

    @if (_session.Selection is { Decoded.IsEmpty: false })
    {
        <div class="mb-4" style="max-width:800px">
            @* Readiness and counts belong to the selected output's
               representation (SPEC-notices.md §7.3): the line, the zero-match
               notice and Download read the selected key's state, and a key
               not converted yet shows no count at all — never zero matches. *@
            @if (SelectedConverted is int converted && converted > 0)
            {
                @if (FilterInEffect is null)
                {
                    // The unfiltered row total: the rows whose conversion
                    // succeeded, never taken as evidence about the records.
                    <div class="mb-2 text-muted">
                        @Projections.Rows.Count rows loaded — set filters and click Apply Filter
                    </div>
                }
                else if (SelectedMatched == 0)
                {
                    // Items converted but the applied filter set excluded every
                    // one of them. Because an empty (inactive) set passes
                    // everything, a zero count here means the filters are
                    // genuinely active — so we can say so without re-inspecting
                    // FilterConfig. Replaces the bland "0 of N match" line that
                    // read as a silent success.
                    //
                    // A gate reason — it is the filter's result — so not
                    // dismissible (SPEC-notices.md, Fork C).
                    <Notice class="zero-match-notice" Kind="NoticeKind.Warning"
                            Announcement="NoticeAnnouncement.Assertive">
                        No decisions matched these filters — adjust the filters or
                        select different files.
                    </Notice>
                }
                else
                {
                    <div class="mb-2 text-muted" id="matchCount">
                        @SelectedMatched of @converted @SelectedNoun match current filters
                    </div>
                }
            }

            <label class="form-label">Filename</label>
            <input class="form-control mb-3" style="max-width:400px"
                   placeholder="decisions.csv"
                   value="@_csvFileName"
                   @oninput="OnCsvFileNameChanged" />

            <button class="btn btn-primary"
                    @onclick="DownloadAsync"
                    disabled="@(!DownloadReady)">
                @(IsBusy ? "Building…" : DownloadButtonLabel)
            </button>
            @if (FilterInEffect is null)
            {
                <small class="text-muted ms-2">Apply filters first</small>
            }
            else if (XgpDownloadBlocked)
            {
                <small class="text-muted ms-2" id="xgpBlockedHint">
                    @(XgpNumberingUnreadable
                        ? XgpNumberingHints.ResolveUnreadable
                        : XgpNothingMatches
                        ? "No decisions match the filters"
                        : "Fix the XGP export options first")
                </small>
            }
        </div>
    }

    @* "The last download" (SPEC-notices.md §7.3, projection B, ruled F1 and F2
       in §7.4): the decisions the last attempt skipped because their payload
       could not be prepared, labelled as that attempt — its format and how it
       ended (WebDownload.Label) — so it never reads as a verdict on a
       different output. The next
       attempt's start replaces it, and a new pick clears it. *@
    @if (_session.LastDownload is { } lastDownload)
    {
        <div style="max-width:800px">
            <SkipListNotice class="mb-3 download-skips" Record="lastDownload.ExportSkips"
                            Label="@lastDownload.Label" />
        </div>
    }

    @* The preview shows the rows the selected output is built from, so it is
       there only while that output is built from rows (CSV and XGP) and they
       are converted. Diagram JSON is built from records, which convert on
       their own (halheinrich/backgammon#74): a rows table beside it could
       describe a different set from the download's, so there is none. *@
    @if (FilterInEffect is not null && SelectedRepresentation == Representation.Rows
         && _session.StateOf(Representation.Rows) == ConversionState.Completed
         && Projections.FilteredRows.Count > 0)
    {
        <h5>Preview (first @(Math.Min(20, Projections.FilteredRows.Count)) of @Projections.FilteredRows.Count filtered rows, @Projections.Rows.Count total)</h5>
        <div style="overflow-x:auto">
            <table class="table table-sm table-striped table-bordered">
                <thead class="table-dark">
                    <tr>
                        <th>Xgid</th>
                        <th>Error</th>
                        <th>MatchScore</th>
                        <th>MatchLength</th>
                        <th>Player</th>
                        <th>SourceFile</th>
                        <th>Game</th>
                        <th>MoveNumber</th>
                        <th>Roll</th>
                        <th>AnalysisDepth</th>
                        <th>Equity</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in Projections.FilteredRows.Take(20))
                    {
                        <tr>
                            <td><code style="font-size:.75em">@r.Xgid</code></td>
                            <td>@r.Error</td>
                            <td>@r.MatchScore</td>
                            <td>@r.MatchLength</td>
                            <td>@r.Player</td>
                            <td>@r.SourceFile</td>
                            <td>@r.Game</td>
                            <td>@r.MoveNumber</td>
                            <td>@r.Roll</td>
                            <td>@r.AnalysisDepth</td>
                            <td>@r.Equity</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

</div>

@code {
    private const long WebModeLimitBytes = 50L * 1024 * 1024;

    [Parameter] public OutputFormat OutputFormat { get; set; }

    /// <summary>
    /// The filter in effect for this panel's selection, or
    /// <see langword="null"/> when none is — the host's one filter fact
    /// (<c>Home.FilterInEffect</c>). It gates the Download button, the
    /// preview and the match-count line, and is what the retained rows and
    /// records are filtered by. The empty selection is in effect without Apply
    /// (halheinrich/backgammon#266).
    /// </summary>
    /// <remarks>
    /// One fact, so one parameter: a config beside a separate "applied" flag
    /// could disagree with it. The host hands a new instance on each render
    /// (the owner's <c>ConfigInEffectFor</c> does), so the row cache compares
    /// it by value.
    /// </remarks>
    [Parameter, EditorRequired] public FilterConfig? FilterInEffect { get; set; }

    [Parameter, EditorRequired] public XgpExportOptions XgpOptions { get; set; } = default!;
    [Parameter, EditorRequired] public bool XgpAnonymize { get; set; }

    /// <summary>
    /// Whether the host's numbering record cannot be read and the user has not
    /// resolved it (the umbrella's <c>SPEC-notices.md</c> §7.5): it may hold
    /// exports this browser has not accounted for, so XGP download waits. The
    /// host shows the gate reason and carries its resolution. EditorRequired:
    /// a silently splatted binding would let an XGP download run over it.
    /// </summary>
    [Parameter, EditorRequired] public bool XgpNumberingUnreadable { get; set; }

    /// <summary>
    /// Raised when an XGP download attempt begins, before anything is built:
    /// the host notes the moment, so its controls know which of the user's
    /// edits came after the export started (the umbrella's
    /// <c>SPEC-notices.md</c> §7.5). EditorRequired: a silently splatted
    /// binding would leave the host unable to tell.
    /// </summary>
    [Parameter, EditorRequired] public EventCallback OnXgpExportStarting { get; set; }

    /// <summary>
    /// Raised with an XGP download's commit — the entries of the archive
    /// handed to the browser and the options the download captured — once the
    /// hand-off has succeeded: the host owns the numbering those entries used.
    /// EditorRequired: a silently splatted binding here would lose the
    /// accounting.
    /// </summary>
    [Parameter, EditorRequired] public EventCallback<XgpExportCommit> OnXgpExported { get; set; }

    /// <summary>
    /// Raised once per file-selection gesture — every
    /// <see cref="HandleFileSelectionAsync"/> invocation, because every one
    /// replaces (or clears) the selection before anything else runs — with the
    /// new selection's token, or <see langword="null"/> when the gesture left
    /// nothing selected (a dismissed picker, a selection over the size limit).
    /// The selection is Web mode's filter <em>source</em>; the host reports the
    /// token to the filter setup, so a new selection ends the setup exactly as
    /// a new Local folder does. EditorRequired: a silently splatted binding
    /// here is a source change nobody hears of.
    /// </summary>
    [Parameter, EditorRequired] public EventCallback<FilterSourceToken?> OnSelectionChanged { get; set; }

    // ── The selection's identity ────────────────────────────────────────────
    //
    // The selection — its decoded files, their conversions and the
    // projections, all in _session — is this panel's, so its token is too:
    // minted when a gesture selects files, held by the selection, and gone
    // with it (a clearing gesture, or this panel's disposal). Two selections
    // never share a token, also across panel instances: the filter setup
    // outlives every page, so a page-lived counter would mint the same token
    // again after a navigation, and a new pick would inherit an old pick's
    // consent. The counter is therefore process-wide — one per loaded app
    // under WebAssembly — and only ever moves forward.
    private static int s_lastSelectionNumber;

    private static FilterSourceToken MintSelectionToken() =>
        FilterSourceToken.FromGeneration(Interlocked.Increment(ref s_lastSelectionNumber));

    private string _csvFileName = "decisions.csv";
    private string _lastFolderHint = string.Empty;
    private long _totalSelectedBytes = 0;

    // Busy state for every slow gesture on this panel — raised only through
    // RunBusyAsync, which owns the paint discipline that makes it visible. A
    // count, not a flag: a gesture can begin while another's await is
    // pending (a newer pick supersedes an older one), and the panel is busy
    // until the last of them ends.
    private int _busyDepth;
    private bool IsBusy => _busyDepth > 0;
    private string _busyMessage = string.Empty;

    // Busy marker for the panel root. It rides IsBusy — the state the panel
    // already keeps — so every window RunBusyAsync opens gets the cursor,
    // including any gesture routed through the wrapper later. The class
    // carries no cursor of its own; app.css holds the single rule, the same
    // one LocalModePanel's root uses (issue halheinrich/backgammon#77).
    private string? BusyCssClass => IsBusy ? "is-busy" : null;

    // The failed gesture standing on screen, as its message; null when none
    // is. The run error notice's whole state — presence, text and dismissal
    // are this one field (see the notice's comment in the markup). The
    // selected-size limit is deliberately not written here: it is a standing
    // gate reason with its own owner, _totalSelectedBytes.
    private string? _runError;

    // Web mode's state, owned by this panel and dying with it: the selection,
    // its conversion cache, the book in force, the projections and the last
    // download (SPEC-notices.md §7.3). The ranking is the application's one
    // ranking, so every row is built for it and every record filtered under it.
    private WebSession _session = default!;

    // This panel's lifetime: an operation it started that is still running
    // when the panel goes is cancelled, and publishes nothing — the selection
    // it belonged to died with the panel.
    private readonly CancellationTokenSource _lifetime = new();

    /// <summary>
    /// The projections — retained rows and records and their filtered views —
    /// exposed so wire tests can pin the panel→cache routing without
    /// reflection.
    /// </summary>
    internal FilteredRowCache RowCache => _session.Projections;

    /// <summary>The panel's Web-mode state, exposed as a test seam beside <see cref="RowCache"/>.</summary>
    internal WebSession Session => _session;

    private FilteredRowCache Projections => _session.Projections;

    // OpeningBookV2.ob is ~13.6 MB; the InputFile stream default cap (500 KB)
    // would reject it, so the book stream is read with this larger ceiling. The
    // book is a separate pick from the .xg files and is not counted against
    // WebModeLimitBytes.
    private const long OpeningBookMaxBytes = 64L * 1024 * 1024;

    protected override void OnInitialized() =>
        _session = new WebSession(Converter, AppRanking.Ranking);

    public void Dispose()
    {
        _lifetime.Cancel();
        _lifetime.Dispose();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        _csvFileName = await Settings.ReadAsync("xg_csvFileName") ?? "decisions.csv";
        _lastFolderHint = await Settings.ReadAsync("xg_lastFolderHint") ?? string.Empty;
        StateHasChanged();
    }

    protected override async Task OnParametersSetAsync()
    {
        // Re-filter by the filter in effect. Whether one is in effect is the
        // panel's one filtering decision; materialization (cached by config
        // value) and projection live in the cache, over what is retained.
        if (FilterInEffect is { } filter)
            _session.Refilter(filter);

        // Update filename extension when output format changes
        if (!string.IsNullOrWhiteSpace(_csvFileName))
        {
            var expectedExt = OutputFormat switch
            {
                OutputFormat.DiagramJson => ".json",
                OutputFormat.Xgp         => ".zip",
                _                        => ".csv",
            };
            if (!_csvFileName.EndsWith(expectedExt, StringComparison.OrdinalIgnoreCase))
            {
                _csvFileName = Path.ChangeExtension(_csvFileName, expectedExt);
                _ = Settings.WriteAsync("xg_csvFileName", _csvFileName);
            }
        }

        // A format switch selects the new format's representation, and
        // requests its conversion when nobody has — so records convert when
        // Diagram JSON is first selected, and only then
        // (halheinrich/backgammon#74).
        await ConvertWhatTheSelectedOutputNeedsAsync();
    }

    /// <summary>
    /// Converts what the selected output needs and nobody has requested. While
    /// a gesture is busy this does nothing: it is that gesture's to do, and
    /// every gesture ends by converting what the selected output needs, reading
    /// the format afresh — a pick and a book load inside their work, a
    /// download once its attempt has ended.
    /// </summary>
    private Task ConvertWhatTheSelectedOutputNeedsAsync() =>
        !IsBusy && _session.Needs(SelectedRepresentation)
            ? RunBusyAsync(ConvertingMessage, EnsureConversionsAsync)
            : Task.CompletedTask;

    private async Task HandleFileSelectionAsync(InputFileChangeEventArgs e)
    {
        _runError = null;

        var files = e.GetMultipleFiles(500).ToList();
        _totalSelectedBytes = files.Sum(f => f.Size);

        // Over the limit nothing is read, and a dismissed picker selects
        // nothing: either way the gesture leaves no selection. Otherwise the
        // files are the new selection, with a token of its own. The old
        // selection ends here on every path — and with it its conversions,
        // its projections and its last download — and any pick still reading
        // is superseded: it will publish nothing.
        var selecting = files.Count > 0 && _totalSelectedBytes <= WebModeLimitBytes;
        var pick = _session.BeginPick();
        FilterSourceToken? token = selecting ? MintSelectionToken() : null;

        // The source change is announced unconditionally — once, with the
        // outcome's token — before anything is read.
        await OnSelectionChanged.InvokeAsync(token);

        // Over the limit: the reason is on screen already, by the picker,
        // rendered from _totalSelectedBytes itself — a gate reason that stands
        // until the selection changes (SPEC-notices.md §1): one fact, one
        // owner, one box. And for a dismissed picker the clear above is the
        // whole effect: raising busy for it would flash a notice over no work
        // (the wrapper's yield guarantees the flash would paint).
        if (!selecting) return;

        // The hint is a convenience: a refused write is reported to the
        // storage condition and returns, and the upload goes on. At no point
        // may persisting it stand between the user and their files.
        _lastFolderHint = $"{files.Count} file(s) — first: {files[0].Name}";
        await Settings.WriteAsync("xg_lastFolderHint", _lastFolderHint);

        await RunBusyAsync(
            $"Reading {files.Count} file(s) and extracting decisions…",
            () => GuardedAsync(async () =>
            {
                // Each file is read once; a file that cannot be read is named
                // in "this selection" with the reader's message, and the good
                // ones load (halheinrich/backgammon#364).
                var picked = files
                    .Select(f => new PickedFile(f.Name,
                        ct => Task.FromResult(f.OpenReadStream(maxAllowedSize: WebModeLimitBytes, ct))))
                    .ToList();
                if (await _session.CompletePickAsync(pick, token!.Value, picked, _lifetime.Token))
                    await _session.EnsureConversionsAsync(() => SelectedRepresentation, _lifetime.Token);
            },
            gestureOwns: () => _session.IsLatest(pick)));
    }

    private async Task HandleOpeningBookSelectionAsync(InputFileChangeEventArgs e)
    {
        var load = _session.BeginBookLoad();

        // One message has to cover the whole gesture: the load and the
        // re-extract both hold the thread, so there is no frame in between to
        // update it in. Naming the re-extract when there are decoded files to
        // re-extract from is what keeps the notice from under-promising a
        // multi-second wait. Nothing is read again: the selection keeps each
        // decoded file.
        var decodedCount = _session.Selection?.Decoded.Length ?? 0;
        var message = decodedCount > 0
            ? $"Loading opening book and re-extracting decisions from {decodedCount} file(s)…"
            : "Loading opening book…";

        await RunBusyAsync(message, () => GuardedAsync(async () =>
        {
            OpeningBook? book = null;
            var failed = false;
            try
            {
                using var ms = new MemoryStream();
                await e.File.OpenReadStream(maxAllowedSize: OpeningBookMaxBytes, _lifetime.Token).CopyToAsync(ms, _lifetime.Token);
                failed = !Processor.TryLoadOpeningBook(ms.ToArray(), out book);
            }
            catch (Exception ex) when (ex is not OperationCanceledException)
            {
                failed = true;
            }

            // A book chosen after the files still enriches them: a new book is
            // a new conversion key, so the selection's rows reconvert under it
            // — each file within its own boundary, as on a pick
            // (halheinrich/backgammon#364) — and its records when an output
            // needs them.
            if (_session.CompleteBookLoad(load, book, failed))
                await _session.EnsureConversionsAsync(() => SelectedRepresentation, _lifetime.Token);
        },
        gestureOwns: () => _session.IsLatest(load)));
    }

    /// <summary>
    /// Runs a gesture's work: a cancellation from this panel's own lifetime
    /// ends it silently, since the panel has gone; anything else that escapes
    /// — never a file's failure, which is a skip — is a failure, the run
    /// error, while its owner still owns it. A failure is published by the
    /// same owner rules as a result and a skip record (SPEC-notices.md §7.3):
    /// a conversion's by the selection and book it converted for, while its
    /// key is one the selected output still needs — rows always, records for
    /// Diagram JSON — whichever gesture asked for it
    /// (<see cref="WebSession.Owns"/>); anything else by its gesture
    /// (<paramref name="gestureOwns"/>, asked when it fails). A superseded
    /// failure publishes nothing, and is logged instead.
    /// </summary>
    private async Task GuardedAsync(Func<Task> work, Func<bool> gestureOwns)
    {
        try
        {
            await work();
        }
        catch (OperationCanceledException) when (_lifetime.IsCancellationRequested)
        {
        }
        catch (Exception ex) when (ex is ConversionFailedException conversion
                                       ? _session.Owns(conversion, SelectedRepresentation)
                                       : gestureOwns())
        {
            _runError = $"Error: {ex.Message}";
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "A superseded Web-mode gesture failed; its failure is not shown.");
        }
    }

    // Converting what the selected output needs, for the format switch that
    // asked: a conversion's failure is owned by its selection and book while
    // its key is one the selected output still needs (WebSession.Owns), and
    // anything else by the selection it was asked for.
    private Task EnsureConversionsAsync()
    {
        var selection = _session.Selection;
        return GuardedAsync(
            () => _session.EnsureConversionsAsync(() => SelectedRepresentation, _lifetime.Token),
            gestureOwns: () => ReferenceEquals(selection, _session.Selection));
    }

    /// <summary>
    /// Runs <paramref name="body"/> with the panel's busy notice showing.
    /// </summary>
    /// <remarks>
    /// The <c>await Task.Yield()</c> is the load-bearing line. WASM runs Blazor
    /// on one thread and <c>StateHasChanged</c> only *queues* a render, so a
    /// busy state raised immediately before synchronous work never reaches the
    /// screen: the flag flips and reverts inside a single task and the
    /// affordance does nothing while looking correct in review. The yield hands
    /// the thread back so the queued render can paint before
    /// <paramref name="body"/> takes it again. Measured on issue halheinrich/backgammon#53 — without
    /// it, the "Building…" label entered the DOM 14 ms *after* a 6.6 s zip
    /// build had already finished.
    /// <para>
    /// Every slow Web-mode gesture goes through here, so the discipline lives in
    /// one place rather than being re-derived per handler. Each body keeps its
    /// own error handling; this wrapper owns only the busy state, and releases
    /// it in a <c>finally</c> that covers everything after the depth is raised
    /// — its own render request and yield as well as the body — so nothing
    /// that throws can strand the notice on screen. The same render that
    /// paints the notice puts <c>is-busy</c> on the panel root, so the busy
    /// cursor is on screen before the body takes the thread — the yield is
    /// what buys both.
    /// </para>
    /// </remarks>
    private async Task RunBusyAsync(string message, Func<Task> body)
    {
        try
        {
            _busyDepth++;
            _busyMessage = message;
            StateHasChanged();
            await Task.Yield();
            await body();
        }
        finally
        {
            if (--_busyDepth == 0)
                _busyMessage = string.Empty;
            StateHasChanged();
        }
    }

    /// <summary>
    /// Test seam for the busy contract — the same wrapper every slow gesture
    /// runs through, reachable without a real file pick so the ordering tests
    /// can supply a body that observes when it was called. Sibling of the
    /// <see cref="RowCache"/> seam; not a production entry point.
    /// </summary>
    internal Task RunBusyForTest(string message, Func<Task> body) =>
        RunBusyAsync(message, body);

    /// <summary>
    /// Test seam for a click that reaches the download gesture past its gate —
    /// a stale click, made against a render the state has since moved past —
    /// which a disabled button's click cannot express. Sibling of
    /// <see cref="RunBusyForTest"/>; not a production entry point.
    /// </summary>
    internal Task DownloadForTest() => DownloadAsync();

    private async Task OnCsvFileNameChanged(ChangeEventArgs e)
    {
        _csvFileName = e.Value?.ToString() ?? string.Empty;
        await Settings.WriteAsync("xg_csvFileName", _csvFileName);
    }

    // ── The selected output's representation ────────────────────────────────

    // Rows for CSV and XGP, records for Diagram JSON (SPEC-notices.md §7.1).
    private static Representation RepresentationOf(OutputFormat format) =>
        format == OutputFormat.DiagramJson ? Representation.Records : Representation.Rows;

    private Representation SelectedRepresentation => RepresentationOf(OutputFormat);

    // The selected key's converted count, or null while it is not converted
    // yet — "not converted yet" is never zero.
    private int? SelectedConverted =>
        _session.StateOf(SelectedRepresentation) != ConversionState.Completed ? null
        : SelectedRepresentation == Representation.Records ? Projections.Records.Count
        : Projections.Rows.Count;

    private int SelectedMatched =>
        SelectedRepresentation == Representation.Records
            ? Projections.FilteredDiagramRows.Count
            : Projections.FilteredRows.Count;

    private string SelectedNoun => SelectedRepresentation == Representation.Records ? "decisions" : "rows";

    // Records serve Diagram JSON alone in Web mode; its name is the one
    // OutputFormatNames states.
    private string ConvertingMessage => SelectedRepresentation == Representation.Records
        ? $"Converting decisions for {OutputFormat.DiagramJson.ShortName()}…"
        : "Extracting decisions…";

    // The Download gate — the button's and its click's one definition, so a
    // click that reaches the gesture past a dark button begins nothing.
    // Download needs no gesture in hand, a filter in effect, a selection
    // within the size limit, and the selected key converted with something in
    // it; Xgp also needs a numbering record that can be read, matching
    // decisions and valid naming options. The text formats tolerate an empty
    // filtered set (header-only CSV / empty JSON array).
    private bool DownloadReady =>
        !IsBusy
        && FilterInEffect is not null
        && _totalSelectedBytes <= WebModeLimitBytes
        && SelectedConverted > 0
        && !XgpDownloadBlocked;

    private bool XgpDownloadBlocked =>
        OutputFormat == OutputFormat.Xgp
        && (XgpNumberingUnreadable || XgpNothingMatches || !XgpOptions.TryValidate(out _));

    // The XGP output's rows are converted and the filter admits none of them.
    // Read off the selected key's state, so rows not converted yet are never
    // "nothing matches" (SPEC-notices.md §7.3).
    private bool XgpNothingMatches =>
        OutputFormat == OutputFormat.Xgp && SelectedConverted > 0 && SelectedMatched == 0;

    private string DownloadButtonLabel => OutputFormat switch
    {
        OutputFormat.DiagramJson => "Download JSON",
        OutputFormat.Xgp         => "Download ZIP",
        _                        => "Download CSV",
    };

    private static string BuildingMessage(OutputFormat format) => format switch
    {
        OutputFormat.DiagramJson => "Building JSON…",
        OutputFormat.Xgp         => "Building ZIP…",
        _                        => "Building CSV…",
    };

    // ── The download ────────────────────────────────────────────────────────

    /// <summary>
    /// What one download attempt captured at its start (SPEC-notices.md §7.3):
    /// its ticket — its ownership of its record, and the projection it builds
    /// from — and the format, filter, options and file name it depends on. A
    /// change to any of them while the attempt runs neither discards nor
    /// reinterprets it.
    /// </summary>
    private sealed record DownloadAttempt(
        DownloadTicket Ticket,
        OutputFormat Format,
        FilterConfig Filter,
        XgpExportOptions Options,
        bool Anonymize,
        string FileName);

    /// <summary>
    /// The download gesture. Its attempt begins at the click, before the busy
    /// wrapper's yield hands the thread back, so a format switch, a filter
    /// change or an options edit in that window belongs to a later attempt,
    /// never this one; and it begins only past the button's own gate
    /// (<see cref="DownloadReady"/>), from a converted representation. The
    /// gesture then ends as every gesture does, by converting what the
    /// selected output now needs: a format switch while it was busy was left
    /// to it.
    /// </summary>
    /// <remarks>
    /// The busy notice is not format-gated: CSV is the fast one today, but the
    /// builders share this one path and the yield costs a single frame, so
    /// gating it would buy a special case and nothing else.
    /// </remarks>
    private async Task DownloadAsync()
    {
        if (DownloadReady && BeginAttempt() is { } attempt)
        {
            if (attempt.Format == OutputFormat.Xgp)
                await OnXgpExportStarting.InvokeAsync();
            await RunBusyAsync(BuildingMessage(attempt.Format), () => DownloadCoreAsync(attempt));
        }
        await ConvertWhatTheSelectedOutputNeedsAsync();
    }

    /// <summary>
    /// Begins an attempt for the selected output, capturing what it depends
    /// on; <see langword="null"/>, beginning nothing, when no filter is in
    /// effect to build it through, or the session has no converted
    /// representation to begin one from.
    /// </summary>
    private DownloadAttempt? BeginAttempt()
    {
        if (FilterInEffect is not { } filter)
            return null;
        var format = OutputFormat;
        if (_session.BeginDownload(RepresentationOf(format)) is not { } ticket)
            return null;
        var fileName = string.IsNullOrWhiteSpace(_csvFileName)
            ? format switch { OutputFormat.DiagramJson => "decisions.json", OutputFormat.Xgp => "decisions.zip", _ => "decisions.csv" }
            : _csvFileName;
        return new DownloadAttempt(ticket, format, filter, XgpOptions, XgpAnonymize, fileName);
    }

    /// <summary>
    /// One download attempt (SPEC-notices.md §7.3): it builds its file from
    /// what it captured, prepares each XGP decision within its own boundary,
    /// and commits once — the finalized file's hand-off to the browser. Its
    /// record becomes "the last download" unless a newer attempt or selection
    /// has taken over; what a successful XGP hand-off committed reaches the
    /// host's numbering whatever is shown.
    /// </summary>
    /// <remarks>
    /// The hand-off ends the attempt. Recording what it committed comes after,
    /// outside the attempt's failure handling: a failure there is shown as the
    /// run error, and the download stays completed — it was delivered.
    /// </remarks>
    private async Task DownloadCoreAsync(DownloadAttempt attempt)
    {
        _runError = null;

        var (ticket, format, fileName) = (attempt.Ticket, attempt.Format, attempt.FileName);
        var exportSkips = SkipRecord.Empty;
        XgpExportCommit? numbering = null;
        try
        {
            byte[] bytes;
            string mimeType;
            int committed;

            if (format == OutputFormat.Xgp)
            {
                var archive = Processor.BuildXgpArchive(
                    ticket.Decisions, attempt.Options, attempt.Filter, attempt.Anonymize,
                    skipped => exportSkips = exportSkips.With(skipped));
                bytes = archive.Bytes;
                mimeType = "application/zip";
                committed = archive.Commit.Count;
                numbering = archive.Commit;
            }
            else if (format == OutputFormat.DiagramJson)
            {
                bytes = System.Text.Encoding.UTF8.GetBytes(Processor.BuildDiagramJson(ticket.Records));
                mimeType = "application/json";
                committed = ticket.Records.Count;
            }
            else
            {
                bytes = System.Text.Encoding.UTF8.GetBytes(Processor.BuildCsv(ticket.Rows));
                mimeType = "text/csv";
                committed = ticket.Rows.Count;
            }

            // The commit: the hand-off to the browser.
            await JS.InvokeVoidAsync("downloadFile", fileName, mimeType, bytes);

            _session.CompleteDownload(ticket, new WebDownload(
                format, fileName, DownloadStatus.Completed, committed, numbering, exportSkips));
        }
        catch (OperationCanceledException)
        {
            _session.CompleteDownload(ticket, new WebDownload(
                format, fileName, DownloadStatus.Cancelled, 0, null, exportSkips));
            return;
        }
        catch (Exception ex)
        {
            // Nothing was handed over, so nothing counts as exported; the
            // attempt keeps the skips it found. Its failure is the run error
            // by the same owner rule as its record: only while no newer
            // attempt has begun and its selection is current.
            if (_session.CompleteDownload(ticket, new WebDownload(
                    format, fileName, DownloadStatus.Failed, 0, null, exportSkips)))
                _runError = $"Error: {ex.Message}";
            else
                Logger.LogWarning(ex, "A superseded Web-mode download failed; its failure is not shown.");
            return;
        }

        // The archive was delivered, so the numbers it used are recorded,
        // whatever is now shown — from the options it captured. The host's
        // accounting, not the attempt's: its failure is the run error, and the
        // download stays completed.
        if (numbering is not null)
        {
            try
            {
                await OnXgpExported.InvokeAsync(numbering);
            }
            catch (Exception ex)
            {
                _runError = $"Error: {ex.Message}";
            }
        }
    }
}
