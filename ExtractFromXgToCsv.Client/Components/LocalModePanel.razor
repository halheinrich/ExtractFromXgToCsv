@using BgDataTypes_Lib
@using XgFilter_Lib.Filtering
@using ExtractFromXgToCsv.Client.Services
@using ExtractFromXgToCsv.Client.Shared
@using XgFilter_Razor
@inject SettingsStorage Settings
@inject HttpClient Http

@* Panel root. It exists to carry the busy marker: everything the user can
   point at while a run is in flight sits inside it, so one class here dresses
   the whole panel with the busy cursor (app.css owns which cursor that is). *@
<div class="@BusyCssClass">

    <section class="mb-4">
        <div style="max-width:800px">
            <div class="mb-3">
                <label class="form-label">Folder path</label>
                @* Controlled input — Home owns the text, its persistence, and
                   the change-boundary latch the filter source token is minted
                   from (the folder is Local mode's filter *source*, so its
                   identity lives with the FilterSurface host). Two events on
                   purpose: @oninput follows every keystroke for persistence,
                   @onchange marks the commit boundary that may re-gate. *@
                <input id="folderPath" class="form-control" placeholder="e.g. D:\xg\matches"
                       value="@FolderPath"
                       @oninput="@(e => FolderPathChanged.InvokeAsync(e.Value?.ToString() ?? string.Empty))"
                       @onchange="@(e => OnFolderPathCommitted.InvokeAsync(e.Value?.ToString() ?? string.Empty))" />
                @if (_bookStatus is not null)
                {
                    <div class="small mt-1" id="bookStatus">
                        @if (_bookStatus.Loaded)
                        {
                            <span class="text-success">
                                ✓ Opening book loaded on the server (@_bookStatus.EntryCount entries) —
                                book decisions show their enriched depth.
                            </span>
                        }
                        else
                        {
                            <span class="text-muted">
                                No opening book loaded on the server — book decisions will show as
                                level Unknown. Set the OpeningBookPath configuration key to enable
                                enrichment.
                            </span>
                        }
                    </div>
                }
            </div>
            <div class="mb-3">
                <label class="form-label">@(OutputFormat == OutputFormat.Xgp ? "Output folder" : "Output path")</label>
                <input id="outputPath" class="form-control"
                       placeholder="@(OutputFormat == OutputFormat.Xgp ? "e.g. D:\\xg\\positions" : "e.g. D:\\xg\\decisions.csv")"
                       value="@_outputPath"
                       @oninput="OnOutputPathChanged" />
            </div>
        </div>
    </section>

    @* The run error — dismissible (SPEC-notices.md, Fork A), and assertive: a
       gesture the user made failed. One occurrence is one failed run, and
       _runError is non-null exactly while one stands, so closing the box ends
       the occurrence — the field is cleared, as the next Run, and inputs that
       no longer match the run's, already clear it — and there is no dismissed bit anywhere,
       here or in the Notice (the binding makes it caller-held, so it keeps
       none). A second failure assigns the field again and shows fresh although
       its text may be identical: the text was never the occurrence. No @if
       around it — one fact, read once. *@
    <Notice class="mt-2" Kind="NoticeKind.Error" Announcement="NoticeAnnouncement.Assertive"
            Dismissible="true"
            @bind-Dismissed:get="_runError is null"
            @bind-Dismissed:set="_ => _runError = null">
        @_runError
    </Notice>

    <div class="mb-4 d-flex gap-2 align-items-center" style="max-width:800px">
        <button class="btn btn-primary"
                @onclick="RunLocalAsync"
                disabled="@(_busy || string.IsNullOrWhiteSpace(FolderPath) || string.IsNullOrWhiteSpace(_outputPath) || FilterInEffect is null || XgpRunBlocked)">
            Run
        </button>
        @if (_busy)
        {
            <button class="btn btn-danger" @onclick="StopLocalAsync">
                Stop
            </button>
        }
        <button class="btn btn-outline-secondary" @onclick="ExitAsync">
            Exit
        </button>
        @* Only with a source: without a folder nothing can be in effect, the
           empty filter included, and the blank folder box already says why
           Run is dark. With one, a filter not in effect is a selection that
           needs Apply — the empty selection is in effect without it
           (halheinrich/backgammon#266). *@
        @if (Source is not null && FilterInEffect is null)
        {
            <small class="text-muted">Apply filters first</small>
        }
        else if (XgpRunBlocked)
        {
            <small class="text-muted">Fix the XGP export options first</small>
        }
    </div>

    @if (_busy || _progress is not null)
    {
        <div style="max-width:800px">
            @if (_progress is null)
            {
                // Busy, but no status snapshot has landed yet — the polling loop's
                // opening Task.Delay(1000) alone guarantees a second of this, and a
                // cold server start makes it longer. Without this branch the whole
                // block renders empty and the only acknowledgement of the click is
                // the Run button greying out.
                <div class="progress mb-2" style="height:24px">
                    <div class="progress-bar progress-bar-striped progress-bar-animated"
                         role="progressbar" style="width:100%"></div>
                </div>
                <div class="small">
                    <span class="text-muted" id="startingNotice">Starting…</span>
                </div>
            }
            else if (_progress is { Complete: false, Phase: JobPhase.Rendering })
            {
                // The deck pathway's atomic render. Current/Total has stopped at
                // 100% and ElapsedSec/FilesPerSec are frozen at the values they
                // held when the last file was read — so the ordinary branch would
                // show a full solid bar beside stale numbers for however long the
                // render runs (minutes at corpus scale). An indeterminate bar and
                // no figures is the honest reading of a phase with no fraction.
                <div class="progress mb-2" style="height:24px">
                    <div class="progress-bar progress-bar-striped progress-bar-animated"
                         role="progressbar" style="width:100%"></div>
                </div>
                <div class="small">
                    <span class="text-muted" id="renderingNotice">
                        @_progress.FileName — @_progress.TotalRows rows collected.
                        This step can't report progress; it finishes in one go.
                    </span>
                </div>
            }
            else
            {
                <div class="progress mb-2" style="height:24px">
                    <div class="progress-bar @(_progress.Cancelled ? "bg-warning" : "")"
                         role="progressbar"
                         style="width:@(_progress.PercentComplete)%">
                        @_progress.PercentComplete%
                    </div>
                </div>
                <div class="small">
                    @if (_progress.Complete && _progress.ErrorMessage is not null)
                    {
                        <span class="text-danger fw-bold">
                            ✗ Error: @_progress.ErrorMessage
                        </span>
                    }
                    else if (_progress.Complete && !_progress.Cancelled)
                    {
                        <span class="text-success fw-bold">
                            ✓ Done — @_progress.TotalRows rows written in @_progress.ElapsedSec.ToString("F1")s
                            (@_progress.FilesPerSec files/sec) → @_run?.OutputPath
                        </span>
                        @if (_progress.TotalRows == 0 && _run is { FilterRestrictsNothing: false }
                             && _progress.Skipped.Count == 0)
                        {
                            // A successful run wrote zero rows through a non-empty
                            // filter set. Because an empty (inactive) set admits
                            // every decision, zero survivors can only mean the
                            // filters are genuinely active — so we surface it as a
                            // filtered-to-zero result rather than letting the bland
                            // "Done — 0 rows" line read as a silent success. Sibling
                            // of WebModePanel's zero-match notice; folder wording for
                            // Local mode. IsEmpty is the seam — no FilterConfig peek
                            // — and it is the run's own filter's, never the one now
                            // on screen: this box describes the run.
                            //
                            // Only when nothing was skipped: that inference assumes
                            // every file was read. With skips the zero may be theirs,
                            // and the skip notice below already says what was lost,
                            // so this one yields rather than blame the filter.
                            //
                            // A gate reason — it is the run's result — so not
                            // dismissible (SPEC-notices.md, Fork C).
                            <Notice class="zero-match-notice mt-2" Kind="NoticeKind.Warning"
                                    Announcement="NoticeAnnouncement.Assertive">
                                No decisions matched these filters — adjust the filters
                                or point at a different folder.
                            </Notice>
                        }
                    }
                    else if (_progress.Cancelled)
                    {
                        <span class="text-warning fw-bold">
                            ⏹ Stopped at file @_progress.Current of @_progress.Total
                            — @_progress.TotalRows rows written in @_progress.ElapsedSec.ToString("F1")s
                            (@_progress.FilesPerSec files/sec)
                        </span>
                    }
                    else
                    {
                        <span class="text-muted">
                            File @_progress.Current of @_progress.Total: @_progress.FileName
                            — @_progress.TotalRows rows, @_progress.ElapsedSec.ToString("F1")s
                            (@_progress.FilesPerSec files/sec)
                        </span>
                    }
                </div>
            }
        </div>
    }

    @if (_lastRun is { } lastRun)
    {
        // The last run's skip record (SPEC-notices.md §7.2): a skip never ends
        // a run, so without this a terminal line reads as a clean result while
        // inputs were dropped (halheinrich/backgammon#223). It is the run's
        // history, apart from the result above: a filter change keeps it,
        // labelled with its run and that run's ending, while "Done" and the
        // zero-match notice go; a new source, or the next run, clears it. A
        // cancelled or failed run's record is as true as a completed one's.
        // Through the one rendering both modes share; it shows nothing for an
        // empty record.
        <div style="max-width:800px">
            <SkipListNotice class="mt-2" Record="lastRun.Skips" Label="@lastRun.Label" />
        </div>
    }

</div>

@code {
    [Parameter] public OutputFormat OutputFormat { get; set; }

    /// <summary>
    /// The current source's token, as Home reports it to the filter setup —
    /// the latched folder, or <see langword="null"/> while none is latched.
    /// Half of what a run's result describes (see <see cref="RunInputs"/>).
    /// </summary>
    [Parameter, EditorRequired] public FilterSourceToken? Source { get; set; }

    /// <summary>
    /// The filter in effect for <see cref="Source"/>, or
    /// <see langword="null"/> when none is — the host's one filter fact
    /// (<c>Home.FilterInEffect</c>), the whole filter half of this panel's
    /// gate, and the filter a run sends. The empty selection is in effect
    /// without Apply (halheinrich/backgammon#266); an edit that moves the
    /// selection off what is in effect makes this null on its own.
    /// </summary>
    /// <remarks>
    /// One fact, so one parameter: a config beside a separate "applied" flag
    /// could disagree with it. The host hands a new instance on each render
    /// (the owner's <c>ConfigInEffectFor</c> does), so compare it by value
    /// (<see cref="FilterConfig.Equals(FilterConfig)"/>), never by reference.
    /// </remarks>
    [Parameter, EditorRequired] public FilterConfig? FilterInEffect { get; set; }

    // The folder input's controlled-component surface. Home owns the value
    // (it is Local mode's filter-source identity, latched host-side at the
    // change boundary); this panel renders it and forwards both event
    // boundaries verbatim. All three are load-bearing for reporting the
    // source, so all three are EditorRequired — a silently splatted binding
    // here would be a source change nobody hears of.
    [Parameter, EditorRequired] public string FolderPath { get; set; } = string.Empty;
    [Parameter, EditorRequired] public EventCallback<string> FolderPathChanged { get; set; }
    [Parameter, EditorRequired] public EventCallback<string> OnFolderPathCommitted { get; set; }

    [Parameter, EditorRequired] public XgpExportOptions XgpOptions { get; set; } = default!;
    [Parameter, EditorRequired] public bool XgpAnonymize { get; set; }

    /// <summary>
    /// Raised with an XGP run's commit — the files it wrote and the options it
    /// captured — when the run ends, completed, cancelled or failed, whatever
    /// the panel shows: the host owns the numbering those files used.
    /// EditorRequired: a silently splatted binding here would lose the
    /// accounting.
    /// </summary>
    [Parameter, EditorRequired] public EventCallback<XgpExportCommit> OnXgpExported { get; set; }

    private bool XgpRunBlocked =>
        OutputFormat == OutputFormat.Xgp && !XgpOptions.TryValidate(out _);

    // Busy marker for the panel root. It rides _busy — the state the panel
    // already keeps, unchanged — so every window that flag covers gets the
    // cursor: the pre-first-poll "Starting…" gap, the deck pathway's
    // multi-minute atomic render, the determinate stretch between them, and
    // any busy window added later. The class carries no cursor of its own;
    // app.css holds the single rule (issue halheinrich/backgammon#77).
    private string? BusyCssClass => _busy ? "is-busy" : null;

    private string _outputPath = string.Empty;
    private ProcessingProgress? _progress = null;
    private string? _currentJobId = null;
    private bool _busy = false;

    // The failed run standing on screen, as its message; null when none is.
    // The run error notice's whole state — presence, text and dismissal are
    // this one field (see the notice's comment in the markup). Distinct from
    // _progress.ErrorMessage, which is the server's report of a job that
    // started and then failed; this is the client's own failure to start or
    // follow one.
    private string? _runError;

    /// <summary>
    /// What a run was computed from: the source it read, the filter values it
    /// applied, and the output path it wrote to — plus whether that filter
    /// restricted nothing, the zero-match box's premise. Captured when the
    /// run starts, so the result on screen is read against its own run, never
    /// against whatever is on screen now.
    /// </summary>
    private sealed record RunInputs(
        FilterSourceToken? Source, FilterConfig Filter, bool FilterRestrictsNothing, string OutputPath);

    // The run whose progress, result or error is on screen; null when none is.
    // A result stands only while its run's source and filter values are still
    // the current ones (see OnParametersSet, and RunLocalAsync's judgement
    // before it publishes a run's outcome).
    private RunInputs? _run;

    /// <summary>
    /// A finished run's skip record, identified with its run: the source it
    /// ran against — the record belongs to the run on that source — and how
    /// it ended, which its label states.
    /// </summary>
    private sealed record LastRunRecord(FilterSourceToken? Source, SkipRecord Skips, RunEnding Ending)
    {
        /// <summary>The list's label: the run it is the history of, and how that run ended.</summary>
        public string Label => Ending switch
        {
            RunEnding.Cancelled => "The last run (stopped)",
            RunEnding.Failed => "The last run (failed)",
            _ => "The last run",
        };

        /// <summary>The record <paramref name="terminal"/> carries, for a run on <paramref name="source"/>.</summary>
        public static LastRunRecord Of(FilterSourceToken? source, ProcessingProgress terminal) =>
            new(source, terminal.Skipped,
                terminal.ErrorMessage is not null ? RunEnding.Failed
                : terminal.Cancelled ? RunEnding.Cancelled
                : RunEnding.Completed);
    }

    /// <summary>How a run that reached its terminal snapshot ended.</summary>
    private enum RunEnding { Completed, Cancelled, Failed }

    // The last run's skip record; null while there is none. Kept apart from
    // the result (_run, _progress, _runError) because it lives by other rules
    // (SPEC-notices.md §7.2): a filter change keeps it, replacing or removing
    // the source clears it, and the next run replaces it.
    private LastRunRecord? _lastRun;

    // Server-side opening-book load state, fetched once on first render so the
    // status line can tell the user which analysis-depth stamps to expect. Null
    // until fetched (or if the fetch fails) — the line renders only when known.
    private OpeningBookStatus? _bookStatus;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        // The folder path is restored by Home (its owner since the source
        // hoist); only the output path — not a source — is still panel-owned.
        _outputPath = await Settings.ReadAsync("xg_outputPath") ?? string.Empty;

        // Server-side book status (Local mode only). A failure leaves the line
        // hidden rather than asserting a state we don't know.
        try { _bookStatus = await Http.GetFromJsonAsync<OpeningBookStatus>("/api/openingbook/status"); }
        catch { _bookStatus = null; }

        StateHasChanged();
    }

    private async Task OnOutputPathChanged(ChangeEventArgs e)
    {
        _outputPath = e.Value?.ToString() ?? string.Empty;
        await Settings.WriteAsync("xg_outputPath", _outputPath);
    }

    protected override void OnParametersSet()
    {
        // Update output path extension when output format changes.
        // Xgp is excluded: its output path is a folder, so no extension is
        // forced onto (or stripped from) whatever the user typed.
        if (!string.IsNullOrWhiteSpace(_outputPath) && OutputFormat != OutputFormat.Xgp)
        {
            var expectedExt = OutputFormat switch
            {
                OutputFormat.DiagramJson => ".json",
                OutputFormat.Pptx        => ".pptx",
                OutputFormat.Pdf         => ".pdf",
                _                        => ".csv",
            };
            if (!_outputPath.EndsWith(expectedExt, StringComparison.OrdinalIgnoreCase))
            {
                _outputPath = Path.ChangeExtension(_outputPath, expectedExt);
                _ = Settings.WriteAsync("xg_outputPath", _outputPath);
            }
        }

        // Drop the run's result the moment it stops describing the current
        // inputs — otherwise "Done — N rows" keeps describing a folder or a
        // filter that is no longer the one on screen. Compared, not edged: an
        // empty filter stays in effect across a folder change, so "a filter is
        // in effect" never falls there, while the source the result was
        // computed from has gone. Not while busy: a running job's progress and
        // Stop stay with their own job, and its outcome is judged before it is
        // published (RunLocalAsync).
        if (!_busy && _run is { } run && !DescribesCurrentInputs(run))
            DropResult();

        // The skip record belongs to the run on the source it ran against:
        // replacing or removing the source clears it, and a filter change
        // does not — it is that run's history, never a verdict on the new
        // filter.
        if (_lastRun is { } lastRun && lastRun.Source != Source)
            _lastRun = null;
    }

    // Whether the current source and filter values are still the ones the run
    // was computed from. Values, not references: the host hands a new config
    // on every render.
    private bool DescribesCurrentInputs(RunInputs run) =>
        run.Source == Source && FilterInEffect is { } current && current.Equals(run.Filter);

    private void DropResult()
    {
        _run = null;
        _progress = null;
        _runError = null;
    }

    private async Task StopLocalAsync()
    {
        if (_currentJobId is not null)
        {
            try { await Http.PostAsync($"/api/process/{_currentJobId}/cancel", null); }
            catch { /* ignore */ }
        }
    }

    private async Task ExitAsync()
    {
        try { await Http.PostAsync("/api/shutdown", null); }
        catch { /* server shuts down, request may not complete */ }
    }

    private async Task RunLocalAsync()
    {
        // The gate guarantees a filter in effect; a stale click past it has
        // nothing to run.
        if (FilterInEffect is not { } filter) return;

        var run = new RunInputs(Source, filter, filter.Build().IsEmpty, _outputPath);
        _run = run;
        _busy = true; _runError = null;
        _progress = null; _currentJobId = null;
        // The next run replaces the last one's record: this run's is shown
        // when it ends, never while it is still growing.
        _lastRun = null;
        StateHasChanged();

        var request = new ProcessRequest
        {
            FolderPath = FolderPath,
            OutputPath = run.OutputPath,
            Filters = run.Filter,
            OutputFormat = OutputFormat,
            XgpOptions = XgpOptions,
            Anonymize = XgpAnonymize
        };

        // The run's outcome, held back until it is judged: the terminal
        // snapshot, or the client's own failure to start or follow the job.
        ProcessingProgress? terminal = null;
        string? failure = null;

        try
        {
            var startResponse = await Http.PostAsJsonAsync("/api/process/start", request);
            startResponse.EnsureSuccessStatusCode();

            var startResult = await startResponse.Content
                .ReadFromJsonAsync<StartResult>();
            _currentJobId = startResult?.JobId;

            if (_currentJobId is null)
            {
                failure = "Failed to start job — no jobId returned.";
            }
            else
            {
                while (true)
                {
                    await Task.Delay(1000);

                    var statusResponse = await Http.GetAsync($"/api/process/{_currentJobId}/status");
                    if (!statusResponse.IsSuccessStatusCode) break;

                    var p = await statusResponse.Content
                        .ReadFromJsonAsync<ProcessingProgress>();

                    if (p is null) continue;
                    if (p.Complete)
                    {
                        terminal = p;
                        break;
                    }

                    // The running job's own progress, shown with its Stop
                    // whatever has changed on screen since it started.
                    _progress = p;
                    StateHasChanged();
                }
            }
        }
        catch (Exception ex)
        {
            failure = $"Error: {ex.Message}";
        }

        _busy = false;
        _currentJobId = null;

        // Judge before publishing: the outcome is shown only while the source
        // and filter values on screen are still the ones the run was computed
        // from. A run that completes after its inputs were superseded — the
        // folder changed, or the filter, while it ran — is never shown as the
        // new inputs' result, not even for the length of the bookkeeping
        // below. Once published, OnParametersSet drops it the moment the
        // inputs move on.
        if (DescribesCurrentInputs(run))
        {
            _progress = terminal ?? _progress;
            _runError = failure;
        }
        else
        {
            DropResult();
        }

        // The run's skip record is published by its own rule: only while the
        // source it ran against is still the current one, whatever the filter
        // now is. A run from a former source publishes none, and cannot
        // restore one.
        _lastRun = terminal is not null && run.Source == Source
            ? LastRunRecord.Of(run.Source, terminal)
            : null;
        StateHasChanged();

        // The job's own accounting, whatever is on screen: the commit an XGP
        // run's terminal snapshot carries, taken from the run's record —
        // completed, cancelled and failed alike, since a failed run's files
        // were written too. Only an XGP run carries one.
        if (terminal?.XgpCommit is { } commit)
        {
            await OnXgpExported.InvokeAsync(commit);
        }
    }

    private class StartResult
    {
        public string? JobId { get; set; }
    }
}
