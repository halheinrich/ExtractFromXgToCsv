@using ExtractFromXgToCsv.Client.Services
@using ExtractFromXgToCsv.Client.Shared
@implements IDisposable
@inject ExtractApp App

@* The Local panel: the coordinator's folder, output path and run, rendered,
   and the gestures on them sent to it as commands. It holds nothing of its
   own (halheinrich/backgammon#424).

   Panel root. It exists to carry the busy marker: everything the user can
   point at while a run is in flight sits inside it, so one class here dresses
   the whole panel with the busy cursor (app.css owns which cursor that is).
   It rides the run in hand, so every window that fact covers gets the cursor:
   the pre-first-poll "Starting…" gap, the deck pathway's multi-minute atomic
   render, the determinate stretch between them, and any busy window added
   later. The class carries no cursor of its own; app.css holds the single
   rule (issue halheinrich/backgammon#77). *@
<div class="@(App.IsRunInHand ? "is-busy" : null)">

    <section class="mb-4">
        <div style="max-width:800px">
            <div class="mb-3">
                <label class="form-label">Folder path</label>
                @* Controlled input — the coordinator owns the text, its
                   persistence, and the change-boundary latch the filter source
                   token is minted from (the folder is Local mode's filter
                   *source*). Two events on purpose: @oninput follows every
                   keystroke for persistence, @onchange marks the commit
                   boundary that may re-gate. *@
                <input id="folderPath" class="form-control" placeholder="e.g. D:\xg\matches"
                       value="@App.FolderPath"
                       @oninput="@(e => App.EditFolderPathAsync(e.Value?.ToString() ?? string.Empty))"
                       @onchange="@(e => App.CommitFolderPath(e.Value?.ToString() ?? string.Empty))" />
                @if (App.BookStatus is { } bookStatus)
                {
                    <div class="small mt-1" id="bookStatus">
                        @if (bookStatus.Loaded)
                        {
                            <span class="text-success">
                                ✓ Opening book loaded on the server (@bookStatus.EntryCount entries) —
                                book decisions show their enriched depth.
                            </span>
                        }
                        else
                        {
                            <span class="text-muted">
                                No opening book loaded on the server — book decisions will show as
                                level Unknown. Set the OpeningBookPath configuration key to enable
                                enrichment.
                            </span>
                        }
                    </div>
                }
            </div>
            <div class="mb-3">
                <label class="form-label">@(App.OutputFormat == OutputFormat.Xgp ? "Output folder" : "Output path")</label>
                <input id="outputPath" class="form-control"
                       placeholder="@(App.OutputFormat == OutputFormat.Xgp ? "e.g. D:\\xg\\positions" : "e.g. D:\\xg\\decisions.csv")"
                       value="@App.OutputPath"
                       @oninput="@(e => App.SetOutputPathAsync(e.Value?.ToString() ?? string.Empty))" />
            </div>
        </div>
    </section>

    @* The run error — dismissible (SPEC-notices.md, Fork A), and assertive: a
       gesture the user made failed. One occurrence is one failed run, and the
       run error is non-null exactly while one stands, so closing the box ends
       the occurrence — the fact is cleared, as the next Run, and inputs that
       no longer match the run's, already clear it — and the Notice keeps no
       dismissed bit (the binding makes it caller-held). A second failure
       sets it again and shows fresh although its text may be identical: the
       text was never the occurrence. While the run goes on, what it shows is
       the run's to say; there the one remembered dismissal is the
       persistent-failure notice's, which holds for the rest of its failure
       streak. No @if around it — one fact, read once. *@
    <Notice class="mt-2" Kind="NoticeKind.Error" Announcement="NoticeAnnouncement.Assertive"
            Dismissible="true"
            @bind-Dismissed:get="App.RunError is null"
            @bind-Dismissed:set="_ => App.DismissRunError()">
        @App.RunError
    </Notice>

    <div class="mb-4 d-flex gap-2 align-items-center" style="max-width:800px">
        <button class="btn btn-primary"
                @onclick="App.RunAsync"
                disabled="@(!App.CanRun)">
            Run
        </button>
        @if (App.IsRunInHand)
        {
            <button class="btn btn-danger" @onclick="App.StopAsync">
                Stop
            </button>
            @* A Stop pressed before the start is answered waits for the
               answer (SPEC-notices.md §7.5): nothing is shown as delivered
               that was not, and a hint that it is pending is allowed. In the
               status-line style of "Starting…", not a notice box, and gone
               the moment the start is answered (Hal's wording, 2026-10-22,
               halheinrich/backgammon#424). *@
            @if (App.IsStopPending)
            {
                <small class="text-muted" id="stopPendingHint">Stop requested; waiting for the server.</small>
            }
        }
        @* Only with a source: without a folder nothing can be in effect, the
           empty filter included, and the blank folder box already says why
           Run is dark. With one, a filter not in effect is a selection that
           needs Apply — the empty selection is in effect without it
           (halheinrich/backgammon#266). *@
        @if (App.AwaitsApply)
        {
            <small class="text-muted">Apply filters first</small>
        }
        else if (App.XgpOptionsInvalid)
        {
            <small class="text-muted">Fix the XGP export options first</small>
        }
    </div>

    @if (App.IsRunInHand || App.Progress is not null)
    {
        var progress = App.Progress;
        <div style="max-width:800px">
            @if (progress is null)
            {
                // Busy, but no status snapshot has landed yet — the polling loop's
                // opening Task.Delay(1000) alone guarantees a second of this, and a
                // cold server start makes it longer. Without this branch the whole
                // block renders empty and the only acknowledgement of the click is
                // the Run button greying out.
                <div class="progress mb-2" style="height:24px">
                    <div class="progress-bar progress-bar-striped progress-bar-animated"
                         role="progressbar" style="width:100%"></div>
                </div>
                <div class="small">
                    <span class="text-muted" id="startingNotice">Starting…</span>
                </div>
            }
            else if (progress is { Complete: false, Phase: JobPhase.Rendering })
            {
                // The deck pathway's render. Current/Total has stopped at
                // 100% and ElapsedSec/FilesPerSec are frozen at the values they
                // held when the last file was read — so the ordinary branch would
                // show a full solid bar beside stale numbers for however long the
                // render runs (minutes at corpus scale). An indeterminate bar and
                // no figures is the honest reading of a phase with no fraction.
                // The render takes the run's token, so Stop still works, and the
                // notice says so (Hal's wording, chat, 2026-10-24).
                <div class="progress mb-2" style="height:24px">
                    <div class="progress-bar progress-bar-striped progress-bar-animated"
                         role="progressbar" style="width:100%"></div>
                </div>
                <div class="small">
                    <span class="text-muted" id="renderingNotice">
                        @progress.FileName — @progress.TotalRows rows collected.
                        This step can't report progress, but Stop still works.
                    </span>
                </div>
            }
            else
            {
                <div class="progress mb-2" style="height:24px">
                    <div class="progress-bar @(progress.Cancelled ? "bg-warning" : "")"
                         role="progressbar"
                         style="width:@(progress.PercentComplete)%">
                        @progress.PercentComplete%
                    </div>
                </div>
                <div class="small">
                    @if (progress.Complete && progress.ErrorMessage is not null)
                    {
                        <span class="text-danger fw-bold">
                            ✗ Error: @progress.ErrorMessage
                        </span>
                    }
                    else if (progress.Complete && !progress.Cancelled)
                    {
                        // An XGP run writes files, not rows (Hal's wording,
                        // chat, 2026-10-23, halheinrich/backgammon#399); it is
                        // the run whose snapshot carries a commit.
                        <span class="text-success fw-bold" id="doneLine">
                            ✓ Done — @progress.TotalRows @(progress.XgpCommit is null ? "rows" : "files") written
                            in @progress.ElapsedSec.ToString("F1")s
                            (@progress.FilesPerSec files/sec) → @progress.WrittenPath
                        </span>
                        @if (progress.TotalRows == 0 && App.RunFilterRestricted
                             && progress.Skipped.Count == 0)
                        {
                            // A successful run wrote zero rows through a non-empty
                            // filter set. Because an empty (inactive) set admits
                            // every decision, zero survivors can only mean the
                            // filters are genuinely active — so we surface it as a
                            // filtered-to-zero result rather than letting the bland
                            // "Done — 0 rows" line read as a silent success, in folder
                            // wording. IsEmpty is the seam — no FilterConfig peek
                            // — and it is the run's own filter's, never the one now
                            // on screen: this box describes the run.
                            //
                            // Only when nothing was skipped: that inference assumes
                            // every file was read. With skips the zero may be theirs,
                            // and the skip notice below already says what was lost,
                            // so this one yields rather than blame the filter.
                            //
                            // A gate reason — it is the run's result — so not
                            // dismissible (SPEC-notices.md, Fork C).
                            <Notice class="zero-match-notice mt-2" Kind="NoticeKind.Warning"
                                    Announcement="NoticeAnnouncement.Assertive">
                                No decisions matched these filters — adjust the filters
                                or point at a different folder.
                            </Notice>
                        }
                    }
                    else if (progress.Cancelled)
                    {
                        // Two independent facts from the run's record, composed
                        // freely (Hal's wording, chat, 2026-10-23,
                        // halheinrich/backgammon#424 6371257599). First where it
                        // stopped (StoppedAt): before the first input file, at a
                        // file, or after processing every one — "processing",
                        // since a skipped file was processed but not read. Then
                        // what output remains: XGP the files its commit counts;
                        // otherwise nothing written, a CSV that closed holding
                        // exactly its rows, or a file whose contents are
                        // uncertain — stopped during its write, or its close
                        // failed — which shows no count. Only the record makes a
                        // stopped snapshot, and it always names the stage; one
                        // without it reads as stopped at a file.
                        <span class="text-warning fw-bold" id="stoppedLine">
                            ⏹ @(progress.StoppedAt switch
                            {
                                StopStage.BeforeFirstInputFile => "Stopped before the first input file",
                                StopStage.AfterInput => $"Stopped after processing all {progress.Total} input files",
                                _ => $"Stopped at file {progress.Current} of {progress.Total}",
                            }) —
                            @if (progress.XgpCommit is not null)
                            {
                                @:@progress.TotalRows files written in @progress.ElapsedSec.ToString("F1")s (@progress.FilesPerSec files/sec)
                            }
                            else if (progress.StoppedOutput is not { } output)
                            {
                                @:nothing written
                            }
                            else if (output.MayBeIncomplete)
                            {
                                @:output may be incomplete: @output.Path
                            }
                            else
                            {
                                @:@progress.TotalRows rows written to @output.Path in @progress.ElapsedSec.ToString("F1")s (@progress.FilesPerSec files/sec)
                            }
                        </span>
                        @if (progress.CloseFailureMessage is { } closeFailure)
                        {
                            // The stop stands (SPEC-notices.md §7.1); a failure
                            // closing the file it left unfinished is reported
                            // beside it, never in its place.
                            <div class="text-danger" id="closeFailure">@closeFailure</div>
                        }
                    }
                    else
                    {
                        <span class="text-muted">
                            File @progress.Current of @progress.Total: @progress.FileName
                            — @progress.TotalRows rows, @progress.ElapsedSec.ToString("F1")s
                            (@progress.FilesPerSec files/sec)
                        </span>
                    }
                </div>
            }
        </div>
    }

    @if (App.LastRunSkips is { } lastRunSkips)
    {
        // The last run's skip record (SPEC-notices.md §7.2): a skip never ends
        // a run, so without this a terminal line reads as a clean result while
        // inputs were dropped (halheinrich/backgammon#223). It is the run's
        // history, apart from the result above: a filter change keeps it,
        // labelled with its run and that run's ending, while "Done" and the
        // zero-match notice go; a new source, or the next run, clears it. A
        // cancelled or failed run's record is as true as a completed one's.
        // Through the one rendering of a skip record; it shows nothing for an
        // empty record.
        <div style="max-width:800px">
            <SkipListNotice class="mt-2" Record="lastRunSkips" Label="@App.LastRunLabel" />
        </div>
    }

</div>

@code {
    // The coordinator moves while no gesture of this panel is running — a
    // status read landing, a Stop's answer — so the panel re-renders off its
    // notification.
    protected override void OnInitialized() => App.Changed += OnAppChanged;

    private void OnAppChanged() => _ = InvokeAsync(StateHasChanged);

    public void Dispose() => App.Changed -= OnAppChanged;
}
