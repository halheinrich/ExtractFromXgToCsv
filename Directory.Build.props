<Project>

  <!-- Repo-wide build policy, matching the XgToJson precedent: every project
       targets one framework, warnings are errors, and public surfaces carry
       XML docs from birth. The test project opts out of doc-file generation
       (in its own csproj) but keeps warnings-as-errors.

       What belongs here: properties that are uniform across this repo's
       projects (server, client, tests) *by policy*, so a change is one edit (a
       future .NET 11 bump is one line). What stays in a csproj: anything
       encoding a per-project decision — the Sdk attribute, RootNamespace,
       IsPackable / IsTestProject, and the test project's doc-file override. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

</Project>
