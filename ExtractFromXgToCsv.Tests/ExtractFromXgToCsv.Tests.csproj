<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- Warnings-as-errors is inherited from the repo-root Directory.Build.props
         and kept. Doc-file generation is opted out here: a test assembly ships
         no consumer-facing API, and its public xUnit methods aren't a
         documented surface, so CS1591 would only demand noise docs on every
         [Fact]. Settled policy — matches the XgToJson test project. -->
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- Direct reference: this project compiles against AngleSharp.Html.Dom
         types (rationale in Directory.Packages.props). -->
    <PackageReference Include="AngleSharp" />
    <PackageReference Include="coverlet.collector" />
    <!-- WebApplicationFactory wire tests for the filterdocument endpoints —
         the Local-mode action guard is only observable through the hosted
         pipeline (FilterDocumentEndpointTests). -->
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="bunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ExtractFromXgToCsv\ExtractFromXgToCsv.csproj" />
    <ProjectReference Include="..\ExtractFromXgToCsv.Client\ExtractFromXgToCsv.Client.csproj" />
    <!-- BgUiPrimitives_Razor's test-support assembly
         (halheinrich/backgammon#377): BrowserStoragePlan, which answers the
         real BrowserStorage's interop calls from expectations stated in the
         accessor's own terms (area, key, value, answer), and NoticeBox. So no
         test here spells a storage interop identifier: the library owns that
         representation, and a change there cannot leave a stale literal
         behind in this suite.

         Test projects only. The assembly declares itself unsupported on the
         browser platform, so the Client could not use it even by mistake, and
         no app-graph project references it. -->
    <ProjectReference Include="..\..\BgUiPrimitives_Razor\BgUiPrimitives_Razor.TestSupport\BgUiPrimitives_Razor.TestSupport.csproj" />
    <!-- XgFilter_Razor's test-support assembly (halheinrich/backgammon#374):
         FilterSurfaceStorage states the filter surface's own storage calls on
         a BrowserStoragePlan — this boot's restoration, each panel mount's
         preference reads, each commit's write — without naming the surface's
         keys, which stay internal to that repo. A rename there breaks this
         build instead of leaving a stale literal that plans nothing.

         Test projects only, like the reference above: IsPackable=false, and
         no app-graph project (server or Client) may reference it. -->
    <ProjectReference Include="..\..\XgFilter_Razor\XgFilter_Razor.TestSupport\XgFilter_Razor.TestSupport.csproj" />
    <!-- BgDataTypes_Lib's test-support assembly (halheinrich/backgammon#273):
         TestRecords, the producer's builders, so a test states only the facts
         it cares about and never restates a record's construction. Test
         projects only, like the reference above: the assembly declares itself
         unsupported on the browser platform, so the Client could not use it
         even by mistake, and no app-graph project references it. -->
    <ProjectReference Include="..\..\BgDataTypes_Lib\BgDataTypes_Lib.TestSupport\BgDataTypes_Lib.TestSupport.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\TestData\FixtureFiles\*.xg;..\..\TestData\FixtureFiles\*.xgp;..\..\TestData\FixtureFiles\*.ob"
             Link="FixtureFiles\%(Filename)%(Extension)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>