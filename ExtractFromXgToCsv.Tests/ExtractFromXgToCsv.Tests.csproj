<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- Warnings-as-errors is inherited from the repo-root Directory.Build.props
         and kept. Doc-file generation is opted out here: a test assembly ships
         no consumer-facing API, and its public xUnit methods aren't a
         documented surface, so CS1591 would only demand noise docs on every
         [Fact]. Settled policy — matches the XgToJson test project. -->
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- Direct reference so the security pin in Directory.Packages.props overrides
         bunit's vulnerable transitive AngleSharp 1.4.0 (GHSA-pgww-w46g-26qg). -->
    <PackageReference Include="AngleSharp" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="bunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ExtractFromXgToCsv\ExtractFromXgToCsv.csproj" />
    <ProjectReference Include="..\ExtractFromXgToCsv.Client\ExtractFromXgToCsv.Client.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\TestData\FixtureFiles\*.xg;..\..\TestData\FixtureFiles\*.xgp;..\..\TestData\FixtureFiles\*.ob"
             Link="FixtureFiles\%(Filename)%(Extension)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>