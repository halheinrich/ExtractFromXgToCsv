<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- Warnings-as-errors is inherited from the repo-root Directory.Build.props
         and kept. Doc-file generation is opted out here: a test assembly ships
         no consumer-facing API, and its public xUnit methods aren't a
         documented surface, so CS1591 would only demand noise docs on every
         [Fact]. Settled policy — matches the XgToJson test project. -->
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- Direct reference: this project compiles against AngleSharp.Html.Dom
         types (rationale in Directory.Packages.props). -->
    <PackageReference Include="AngleSharp" />
    <PackageReference Include="coverlet.collector" />
    <!-- WebApplicationFactory wire tests for the filterdocument endpoints —
         the Local-mode action guard is only observable through the hosted
         pipeline (FilterDocumentEndpointTests). -->
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="bunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ExtractFromXgToCsv\ExtractFromXgToCsv.csproj" />
    <ProjectReference Include="..\ExtractFromXgToCsv.Client\ExtractFromXgToCsv.Client.csproj" />
    <!-- XgFilter_Razor's test-support assembly (halheinrich/backgammon#93):
         producer-owned seeding of the browser state its filter panel restores
         from, so a host test can arrange "a previous visit left a stored
         selection" without repeating the producer's storage key as a literal.
         The key stays internal to that repo; a rename there now breaks this
         build instead of silently leaving a stale literal that arranges
         nothing and passes for the wrong reason.

         Test projects only. The assembly is IsPackable=false and never ships
         beside the component library — no app-graph project (server or
         Client) may reference it. -->
    <ProjectReference Include="..\..\XgFilter_Razor\XgFilter_Razor.Testing\XgFilter_Razor.Testing.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\TestData\FixtureFiles\*.xg;..\..\TestData\FixtureFiles\*.xgp;..\..\TestData\FixtureFiles\*.ob"
             Link="FixtureFiles\%(Filename)%(Extension)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>