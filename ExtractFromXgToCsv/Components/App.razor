<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <title>ExtractFromXgToCsv</title>
    <link rel="stylesheet" href="bootstrap/bootstrap.min.css" />
    <link rel="stylesheet" href="app.css" />
    @* This host's scoped-CSS bundle. Nothing in this repository has scoped CSS
       of its own; the bundle exists to carry the @import of
       BgUiPrimitives_Razor's, which is half of how its Notice works — without
       it a dismissible notice's text is not a click target (only its close
       button and padding dismiss). Resolved through the static-assets
       manifest, as the bundle's own @import is fingerprinted. *@
    <link rel="stylesheet" href="@Assets["ExtractFromXgToCsv.styles.css"]" />
    <HeadOutlet />
</head>

<body>
    <Routes />
    <script src="_framework/blazor.web.js"></script>
    <script>
        // Helper: triggers browser file download from a byte array
        window.downloadFile = (fileName, contentType, bytes) => {
            const blob = new Blob([new Uint8Array(bytes)], { type: contentType });
            const url  = URL.createObjectURL(blob);
            const a    = document.createElement('a');
            a.href     = url;
            a.download = fileName;
            a.click();
            URL.revokeObjectURL(url);
        };
    </script>
</body>

</html>
